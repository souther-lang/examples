<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>example.souther</groupId>
    <artifactId>souther-examples</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>
        Souther の開発ライフサイクルを検証する例。各モジュールは .sou を持ち、
        souther-maven-plugin が生成した型を、型付きの Java から使う。
        souther-lang/souther とは別リポジトリで、`mvn verify` でまとめて検証する。
        （souther.version が SNAPSHOT のブランチでは、先に souther-lang/souther を
        `mvn install` して ~/.m2 に入れておくこと。）
    </description>

    <modules>
        <module>sharedmoney</module>
        <module>invoicing</module>
        <module>crm</module>
        <module>hr</module>
        <module>joboffer</module>
        <module>businesstrip</module>
        <module>member</module>
        <module>ordering</module>
        <module>whodunit</module>
        <module>shippingfee</module>
        <module>realworld</module>
        <module>todomvc</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <souther.version>0.1.0</souther.version>
        <souther.plugin.version>0.1.0</souther.plugin.version>
        <raoh.version>0.7.2</raoh.version>
        <junit.version>6.1.3</junit.version>
        <spring.version>7.0.9</spring.version>
        <jooq.version>3.21.7</jooq.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>org.souther-lang</groupId><artifactId>souther-runtime</artifactId><version>${souther.version}</version></dependency>
            <dependency><groupId>net.unit8.raoh</groupId><artifactId>raoh</artifactId><version>${raoh.version}</version></dependency>
            <dependency><groupId>net.unit8.raoh</groupId><artifactId>raoh-json</artifactId><version>${raoh.version}</version></dependency>
            <dependency><groupId>net.unit8.raoh</groupId><artifactId>raoh-jooq</artifactId><version>${raoh.version}</version></dependency>
            <dependency><groupId>org.jooq</groupId><artifactId>jooq</artifactId><version>${jooq.version}</version></dependency>
            <dependency><groupId>org.springframework</groupId><artifactId>spring-web</artifactId><version>${spring.version}</version></dependency>
            <dependency><groupId>org.springframework</groupId><artifactId>spring-webmvc</artifactId><version>${spring.version}</version></dependency>
            <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId><version>${spring.version}</version></dependency>
            <dependency><groupId>org.springframework</groupId><artifactId>spring-tx</artifactId><version>${spring.version}</version></dependency>
            <dependency>
                <groupId>org.junit</groupId><artifactId>junit-bom</artifactId><version>${junit.version}</version>
                <type>pom</type><scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.1</version></plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- `.sou` under src/main/souther is compiled into target/classes at process-sources,
                 before javac, so the hand-written Java is compiled against the generated types and
                 the jar carries them. What the plugin runs is souther-build-driver at
                 ${souther.version}, resolved like any other dependency. -->
            <plugin>
                <groupId>org.souther-lang</groupId>
                <artifactId>souther-maven-plugin</artifactId>
                <version>${souther.plugin.version}</version>
                <configuration>
                    <southerVersion>${souther.version}</southerVersion>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>compile</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
