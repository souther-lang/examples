// The warehouse side of fulfilment: a third Souther module in this project, alongside example.cart
// and example.ordering. All three .sou under src/main/souther are compiled in one processor run, so
// this module can `import example.cart` the same way ordering does — allocate reads and reserves
// against cart's PricedCart. It is kept separate from ordering so ordering stays the order lifecycle
// and this stays the warehouse.
//
// Eight behaviors — allocate, stockFrom, inspectBarcode, toEaches, toCases, putAway, baySlots,
// checkExpiry — each checked at compile time by its `example`s. No hand-written Java drives them; the
// smoke test only runs one to prove the generated types decode / apply / encode.
//
// Two things this module says that the rest of the project does not:
//   - **A quantity carries its unit.** `Eaches` and `Cases` both wrap `Int` and neither compares with
//     the other — `e >= c` is a type error, not a bug found in production — so the only way from one
//     to the other is `toEaches` / `toCases`, which name the pack size that makes the conversion true.
//     cart counts units without naming the unit, which is where `.value` shows up and is the honest
//     place for it: the unit starts at this module's edge.
//   - **The stock on hand is derived, not held.** `stockFrom` folds the receipts, issues and counts
//     into a snapshot, so the figure and the movements cannot disagree. `account` keeps a balance and
//     writes to it; this keeps the movements and reads the balance off them, and the two are the
//     choice a system makes rather than a rule.
//
// example.shipping imports this module, so it now writes an `exposing` list: a module with none
// exports nothing to import. Writing one turned out to settle three things at once, which is worth
// knowing before adding a second module that depends on this one:
//   - what another module may `import` — shipping speaks Allocated, Location and StockLine;
//   - what is public on the JVM — everything unlisted is package-private, which the smoke test in
//     this same package can still read;
//   - what an injected Java implementation may construct — an injected behavior's `constructs` needs
//     its types exposed or E1305 rejects it, which is why StockSnapshot is listed even though no
//     other module imports it. readStock builds it from the outside.
module example.inventory exposing (
    Allocated,
    Location,
    Eaches,
    Cases,
    PackSize,
    StockLine,
    StockSnapshot
)
import List ( all, indexBy, fold, map )
import example.cart ( Sku, LineItem, PricedCart )

// === A quantity and the unit it is counted in ===
// Both wrap `Int` and neither is the other. A warehouse that says "twelve" has said nothing until it
// says twelve of what, and the two readings of the same shelf are exactly the confusion this pair
// makes unwritable: a comparison of an `Eaches` with a `Cases` does not compile.
data Eaches = Int
    invariant value >= 0
data Cases = Int
    invariant value >= 0

// How many units are in one case. At least one, so the division that turns eaches into cases is safe
// wherever a `PackSize` reaches it.
data PackSize = Int
    invariant value >= 1

// === allocate: read stock, index it, check every line is covered, then commit ===
// Reads the current on-hand for the order's skus, turns the rows into a lookup map, folds "every line
// is within stock" with `all`, and commits only if every line fits; one short line fails the whole
// allocation. This is the "read -> aggregate check -> write" shape: member / account check a single
// row, this checks many lines against read state.

// One snapshot row: a sku and its current on-hand. sku is unique per snapshot — two rows for the same
// sku would collapse into one entry when the rows are indexed — so the uniqueness is an invariant.
// List.allUniqueBy(.sku, rows) says "pull the sku out and there are no duplicates" in one line (a
// property of the List, not of any single row; internally map -> distinct -> length compare, all
// fold-derived, so it is allowed in an invariant).
data StockLine =
    { sku: Sku
    , quantity: Eaches
    }
data StockSnapshot = { rows: List<StockLine> }
    invariant List.allUniqueBy(.sku, rows)

data Allocated = { total: Int }

// --- injected dependencies (Java) ---
// readStock reads the current on-hand for the order's skus.
behavior readStock : (order: PricedCart) -> StockSnapshot
    constructs StockSnapshot, StockLine
// commitStock writes: decrements the stock and returns Allocated.
behavior commitStock : (order: PricedCart) -> Allocated
    constructs Allocated

// The snapshot as a lookup index, built once: `List.indexBy` keys the rows by their sku into a
// `Map<Sku, StockLine>`. Scanning the rows per line with `find` costs a pass per line; indexing costs
// one pass total and every line then reads a key. A `Sku` may be a map key because it is a
// String-backed newtype. Two rows for one sku would collapse into one entry (the later winning),
// which is exactly what the uniqueness invariant above rules out.
let onHand (snap: StockSnapshot): Map<Sku, StockLine> = indexBy(.sku, snap.rows)

// The on-hand for a sku: the indexed row's quantity, or none for a sku the snapshot never mentioned
// (out of stock). Map.get returns an Option, so map then withDefault read through it.
let currentStock (stock: Map<Sku, StockLine>, sku: Sku): Eaches =
    Map.get(sku, stock) |> Option.map(.quantity) |> Option.withDefault(Eaches(0))

// One line is allocatable when its on-hand is at least the ordered quantity. cart's `LineItem` counts
// in bare `Int`s — it prices what somebody put in a basket and has no warehouse to name a unit for —
// so this is where the number becomes an `Eaches` and where the two are compared as one type.
let allocatable (i: LineItem, stock: Map<Sku, StockLine>): Bool =
    currentStock(stock, i.sku) >= Eaches(i.quantity)

// read -> index -> aggregate check -> write. The lambda passed to all captures the local index.
behavior allocate : (order: PricedCart) -> Allocated | InsufficientStock
    depends on readStock, commitStock

let allocate (order, readStock, commitStock) = {
    let stock = onHand(readStock(order))
    guard all(i -> allocatable(i, stock), order.items)
        else InsufficientStock
    commitStock(order)
}

fake readStock
    | (PricedCart { items = [ LineItem { sku = Sku("apple"), quantity = 2, unitPrice = 150, weightGrams = 120 } ], total = 300, highValue = false })
        -> StockSnapshot { rows = [ StockLine { sku = Sku("apple"), quantity = Eaches(5) } ] }
    | _ -> StockSnapshot { rows = [ StockLine { sku = Sku("apple"), quantity = Eaches(1) } ] }

fake commitStock
    | _ -> Allocated { total = 300 }

example allocate
    | "every line within stock is allocated" :
        (PricedCart { items = [ LineItem { sku = Sku("apple"), quantity = 2, unitPrice = 150, weightGrams = 120 } ], total = 300, highValue = false })
            -> Allocated { total = 300 }
    | "one line over stock fails the whole allocation" :
        (PricedCart { items = [ LineItem { sku = Sku("apple"), quantity = 999, unitPrice = 150, weightGrams = 120 } ], total = 149850, highValue = true })
            -> InsufficientStock

// === stockFrom: the snapshot is a reading of the movements, not a figure kept beside them ===
// `readStock` above asks the outside world what the on-hand is, which is what a system with a
// quantity column does. This says where that column comes from: goods received add, goods issued
// subtract, and a stocktake replaces — a count is somebody standing at the shelf, so it overrides the
// running figure rather than adjusting it by a difference nobody measured.
//
// The two behaviors sit side by side on purpose. `account` keeps a balance and writes to it;
// `billing` folds a ledger to age it. Which of the two a context does is a decision, and this module
// is the one place both are written down, so the difference can be read rather than argued about.
//
// The fold runs in bare `Int` because the running figure is allowed to be negative on the way — an
// issue booked before its receipt does that, and it is a real thing that happens to a real warehouse.
// Only the result is an `Eaches`, built after the guard that discharges its invariant, so a snapshot
// that would state a negative on-hand is a reported outcome instead of an abort.
data Receipt = { sku: Sku, quantity: Eaches }
data Issue = { sku: Sku, quantity: Eaches }
data Stocktake = { sku: Sku, counted: Eaches }
data Movement = Receipt | Issue | Stocktake

data WentNegative = { sku: Sku, shortBy: Int }

behavior stockFrom : (movements: List<Movement>) -> StockSnapshot | WentNegative
    constructs StockSnapshot, StockLine, Eaches, WentNegative

let applyMovement (running: Map<Sku, Int>, movement: Movement): Map<Sku, Int> =
    match movement with
        | Receipt { sku, quantity } ->
            Map.upsert(sku, quantity.value, on -> on + quantity.value, running)
        | Issue { sku, quantity } ->
            Map.upsert(sku, 0 - quantity.value, on -> on - quantity.value, running)
        | Stocktake { sku, counted } -> Map.insert(sku, counted.value, running)

// The first sku that ended below zero, in sku order so the answer does not depend on which way the
// map happens to be walked.
let firstNegative (running: Map<Sku, Int>): Option<Sku> =
    List.sort(Map.keys(Map.filter((sku, on) -> on < 0, running))) |> List.get(0)

let stockFrom (movements) = {
    let running: Map<Sku, Int> = fold((acc, m) -> applyMovement(acc, m), Map.empty, movements)
    match firstNegative(running) with
        | Some sku ->
            WentNegative { sku = sku, shortBy = Map.get(sku, running) |> Option.withDefault(0) }
        | None -> StockSnapshot { rows = List.sortBy(.sku, rowsOf(running)) }
}

// `Map.fold` hands the key and the value separately, so the row is built without a tuple to take
// apart and without a stand-in for a key that cannot be absent. The rows come out in sku order
// because a snapshot is read by people, and a map states no order of its own.
let rowsOf (running: Map<Sku, Int>): List<StockLine> =
    Map.fold((acc, sku, on) -> acc ++ [ StockLine { sku = sku, quantity = Eaches(on) } ], [], running)

example stockFrom
    | "receipts add and issues take away" :
        ([ Receipt { sku = Sku("apple"), quantity = Eaches(10) }
         , Issue { sku = Sku("apple"), quantity = Eaches(4) }
         , Receipt { sku = Sku("rice"), quantity = Eaches(2) } ])
            -> StockSnapshot { rows = [ StockLine { sku = Sku("apple"), quantity = Eaches(6) }
                                      , StockLine { sku = Sku("rice"), quantity = Eaches(2) } ] }
    | "a stocktake replaces the running figure rather than adjusting it" :
        ([ Receipt { sku = Sku("apple"), quantity = Eaches(10) }
         , Stocktake { sku = Sku("apple"), counted = Eaches(7) }
         , Issue { sku = Sku("apple"), quantity = Eaches(1) } ])
            -> StockSnapshot { rows = [ StockLine { sku = Sku("apple"), quantity = Eaches(6) } ] }
    | "issuing more than ever arrived is reported, not aborted on" :
        ([ Receipt { sku = Sku("apple"), quantity = Eaches(1) }
         , Issue { sku = Sku("apple"), quantity = Eaches(3) } ])
            -> WentNegative { sku = Sku("apple"), shortBy = 0 - 2 }
    | "no movements is an empty snapshot, not an absent one" :
        ([]) -> StockSnapshot { rows = [] }

// === inspectBarcode: barcode read verification ===
// On receiving, a barcode (JAN / EAN-13) is scanned. If the check digit does not match, the read is
// rejected as a damaged or misread label and the goods are not put away. Digit count and being numeric
// are format invariants; the check digit is a fold (an invariant cannot recurse), so it lives in the
// behavior.
data Barcode = String
    invariant String.matches("[0-9]{13}", value)

data InspectionPassed = { code: Barcode }

behavior inspectBarcode : (barcode: Barcode) -> InspectionPassed | ScanError
    constructs InspectionPassed, ScanError

// EAN-13 weighted sum: positions 1,3,5.. (even index from 0) weigh 1, positions 2,4,6.. (odd index)
// weigh 3. A valid code has its 13-digit weighted sum divisible by 10 (the 13th check digit is chosen
// so). Digits are numeric by the invariant, so digitValue = toCode(ch) - toCode("0") is total.
// List.indexedMap (map with the index) weights each digit; List.sum adds them.
let digitValue (ch: String) = String.toCode(ch) - String.toCode("0")
let weightedSum (code: String) =
    String.toChars(code)
        |> List.indexedMap((i, ch) -> (if Int.modBy(2, i) == 0 then 1 else 3) * digitValue(ch))
        |> List.sum

let inspectBarcode (barcode) = {
    guard Int.modBy(10, weightedSum(barcode.value)) == 0 else ScanError
    InspectionPassed { code = barcode }
}

example inspectBarcode
    | "a correct barcode passes inspection" :
        (Barcode("9784873115658")) -> InspectionPassed { code = Barcode("9784873115658") }
    | "a wrong check digit is a scan error" :
        (Barcode("9784873115659")) -> ScanError

// === toEaches / toCases: the two directions between the units, and the pack size that joins them ===
// The warehouse ships in whole cases. Going down is always exact — a case is a pack size of units, so
// multiplying can only land on a unit count. Going up is not: a quantity that is not a multiple of the
// pack size leaves a remainder, and that remainder is `Eaches` and never `Cases`, which is what makes
// the failure case readable without asking what its number counts.
//
// There is no third direction. Adding an `Eaches` to a `Cases` is a type error, so a total over a
// mixed pick list has to convert first, and the pack size it converted at is named at that call.
behavior toEaches : (cases: Cases, pack: PackSize) -> Eaches
    constructs Eaches

let toEaches (cases, pack) = Eaches(cases.value * pack.value)

data Shippable = { cases: Cases }
data PartialCase = { leftover: Eaches }

behavior toCases : (eaches: Eaches, pack: PackSize) -> Shippable | PartialCase
    constructs Shippable, PartialCase, Cases, Eaches

let toCases (eaches, pack) = {
    let leftover = Int.modBy(pack.value, eaches.value)
    guard leftover == 0 else PartialCase { leftover = Eaches(leftover) }
    Shippable { cases = Cases(eaches.value / pack.value) }
}

example toEaches
    | "two cases of twelve is twenty-four units" : (Cases(2), PackSize(12)) -> Eaches(24)

example toCases
    | "a multiple of the pack size ships as whole cases" :
        (Eaches(24), PackSize(12)) -> Shippable { cases = Cases(2) }
    | "a remainder is left over, and it is counted in units" :
        (Eaches(25), PackSize(12)) -> PartialCase { leftover = Eaches(1) }

// === putAway: a passed item onto a shelf location ===
// A shelf location (aisle-bay-level, e.g. A-03-12). An inspected-and-passed barcode is put away to the
// given shelf. The format is a matches invariant, so a missing digit or a typo is rejected at the
// boundary.
data Location = String
    invariant String.matches("[A-Z]-[0-9]{2}-[0-9]{2}", value)
data PutAwayRecord = { code: Barcode, location: Location }

behavior putAway : (passed: InspectionPassed, location: Location) -> PutAwayRecord
    constructs PutAwayRecord

let putAway (passed, location) = PutAwayRecord { code = passed.code, location = location }

example putAway
    | "a passed item is put away to a shelf" :
        (InspectionPassed { code = Barcode("9784873115658") }, Location("A-03-12"))
            -> PutAwayRecord { code = Barcode("9784873115658"), location = Location("A-03-12") }

// === baySlots: where an item may go, as codes this module builds itself ===
// Until now a Location could only be rejected, never produced: the shelf code arrived from outside and
// the invariant above checked it. Deciding where to put something means naming a shelf, so the code
// has to be assembled here. `String.padLeft` widens each number to the two digits the format wants —
// bay 3 is "03" — and the Location invariant then checks the result exactly as it checks one that came
// in over the wire, so a bay past 99 is rejected at construction rather than shipped as a bad code.
//
// The levels of a bay are 1 to 4 by the racking, not a list anyone stores, so `List.range` produces
// them. That is what it is for: a walk over positions with nothing to walk over yet.
data BayCandidates = { locations: List<Location> }

behavior baySlots : (aisle: String, bay: Int) -> BayCandidates
    constructs BayCandidates, Location

let locationOf (aisle: String, bay: Int, level: Int): Location =
    Location(aisle
        ++ "-" ++ String.padLeft(2, "0", String.fromInt(bay))
        ++ "-" ++ String.padLeft(2, "0", String.fromInt(level)))

let baySlots (aisle, bay) =
    BayCandidates { locations =
        List.range(1, 4) |> List.map(level -> locationOf(aisle, bay, level)) }

example baySlots
    | "a bay offers its four levels, each a well-formed code" :
        ("A", 3)
            -> BayCandidates { locations =
                [ Location("A-03-01"), Location("A-03-02"), Location("A-03-03"), Location("A-03-04") ] }
    | "a two-digit bay needs no padding" :
        ("B", 12)
            -> BayCandidates { locations =
                [ Location("B-12-01"), Location("B-12-02"), Location("B-12-03"), Location("B-12-04") ] }

// === checkExpiry: a lot past its best-before date is held back ===
// The warehouse stores dated lots. Whether a lot may ship today is a pure calendar computation —
// `Date.daysBetween` over the lot's best-before date — so it stays in the domain rather than becoming
// an injected behavior; only reading *today* needs the outside world, and it arrives as an input.
// A date is written `Date("2026-07-25")`, in a body or in a fixture, so the rule is fixed by its
// examples like any other.
data Lot =
    { sku: Sku
    , bestBefore: Date
    }
data Fresh = { sku: Sku }
data Expired = { daysPast: Int }

behavior checkExpiry : (lot: Lot, today: Date) -> Fresh | Expired
    constructs Fresh, Expired

let checkExpiry (lot, today) = {
    let past = Date.daysBetween(lot.bestBefore, today)
    guard past <= 0 else Expired { daysPast = past }
    Fresh { sku = lot.sku }
}

example checkExpiry
    | "a lot still within date ships" :
        (Lot { sku = Sku("milk"), bestBefore = Date("2026-08-01") }, Date("2026-07-25"))
            -> Fresh { sku = Sku("milk") }
    | "a lot past its best-before is held back" :
        (Lot { sku = Sku("milk"), bestBefore = Date("2026-07-20") }, Date("2026-07-25"))
            -> Expired { daysPast = 5 }
    | "the best-before day itself still ships" :
        (Lot { sku = Sku("milk"), bestBefore = Date("2026-07-25") }, Date("2026-07-25"))
            -> Fresh { sku = Sku("milk") }
