// The money side of order-to-cash, and the first module here that sits under a diamond: billing
// imports example.ordering and example.tax, and both of those import example.cart. Three modules
// reach cart's vocabulary by three different routes and all agree on it, because a module is
// resolved once for the whole compile rather than per importer.
//
// The diamond is also where a name has to be owned. `Amount` is declared here and exposed here, and
// example.returns imports it rather than declaring an Amount of its own: two modules exposing the
// same type name cannot both be imported by a third, and there is no import alias to tell them
// apart. Which context owns a shared name is a decision, and the decision is made once, here.
//
// The features on show:
//   - **A due date lands on a day somebody works.** Payment terms give a nominal date, and money does
//     not move on a Sunday or a bank holiday, so the nominal date is walked to a business day in the
//     direction the trading agreement states. The walk is `List.rangeInclusive` and `List.find` over ten
//     candidate days rather than a recursive step, because a recursion on a computed date is not
//     structural and would need `partial` — a finite search says the same thing and stays total.
//     Which day of the week a date falls on is worked out here from a Sunday the calendar carries,
//     since the standard library has `Date.year` / `month` / `day` and no `dayOfWeek`.
//   - **A correction is a new document, not an edit.** An invoice is a statement made on a day; what
//     it stated stays stated. So a price error becomes a credit note against it, and what the customer
//     currently owes is the invoice folded together with its credit notes. Nothing rewrites an
//     `Invoice`, and there is no field on one that a correction would have to reach.
//   - `Decimal` arithmetic end to end — add / subtract / multiply / compare, with `Decimal.abs`,
//     `min`, `max` and `clamp` for the settlement arithmetic. Money is never an Int here; what an
//     invoice states is a Decimal, and Int appears only as a count of days.
//   - An invoice number assembled rather than received: `String.padLeft` widens the sequence,
//     `String.join` puts the parts together, and the `InvoiceNo` invariant checks the result exactly
//     as it checks one that arrived from outside.
//   - `Date.addDays` / `Date.addMonths` for payment terms, `Date.daysBetween` for how early or late
//     a payment landed.
//   - `List.foldRight` walking the ledger from the end, and `List.filter` / `List.map` reading it two
//     more ways.
module example.billing exposing (
    InvoiceNo,
    Amount,
    Terms,
    Net15,
    Net30,
    EndOfNextMonth,
    DueDateRule,
    SameDay,
    PrecedingBusinessDay,
    FollowingBusinessDay,
    PaymentCalendar,
    Invoice,
    Payment,
    Settled,
    PartPaid,
    Overpaid,
    AgeingReport,
    CreditReason,
    PriceError,
    Returned,
    AgreedDiscount,
    CreditNote,
    ExceedsInvoice,
    issueInvoice,
    settle,
    ageing,
    issueCreditNote,
    netOfCredits
)
import example.cart ( Sku, LineItem )
import example.ordering ( OrderId, RecordedOrder )
import example.tax ( TaxRate, TaxBreakdown, TaxCategory )
import List ( map, filter, fold, foldRight, length, find, rangeInclusive, flatMap )

// An invoice number: series, year, and a sequence within the year. It is assembled by this module
// (see `issueInvoice`) and also arrives from outside on a payment, so the format is an invariant
// rather than a convention held in the code that writes it.
data InvoiceNo = String
    invariant String.matches("INV-[0-9]{4}-[0-9]{6}", value)

// Money as it is stated on an invoice. A `Decimal`, not an Int: an invoice is a legal statement of
// an amount and its scale is part of what it states, and the tax module already works in Decimal
// rates. Negative money is not an amount — a refund is a direction, carried by the case that means
// it, not by a sign.
data Amount = Decimal
    invariant value >= 0.0m

// Payment terms as cases rather than a bare number of days: what a contract states is "net 30", and
// the day count follows from it where the due date is worked out. Cases also make a new term a
// compile error at every `match` rather than a number nobody notices.
//
// "End of next month" — the term most Japanese trade actually uses — is a case here rather than a
// day count, because it is not one: which day it lands on depends on the month. It became writable
// when `Date.day` arrived (issue #111); before that the month boundary was out of reach and the
// helper that suggests itself compiles and returns the wrong date.
data Terms = Net15 | Net30 | EndOfNextMonth

// === The days money can actually move ===
// Terms give a nominal date; a bank gives a business day. Which way a nominal date that lands on a
// closed day is walked is a trading agreement and not a law, so it is a case: some contracts pull the
// payment forward so the supplier is never paid late, others push it back so the payer never pays
// early, and a few state the nominal day and mean it.
data DueDateRule = SameDay | PrecedingBusinessDay | FollowingBusinessDay

// The calendar and the convention travel together, because both are agreed with the same counterparty
// at the same time. `aSunday` is any Sunday: the standard library reads a date's year, month and day
// and not its weekday, so the weekday is counted from a day the calendar names. Handing one in is
// better than a constant in this file — a domain that needs a week starting elsewhere says so here.
data PaymentCalendar =
    { holidays: Set<Date>
    , aSunday: Date
    , rule: DueDateRule
    }

let weekday (calendar: PaymentCalendar, d: Date): Int =
    Int.floorMod(Date.daysBetween(calendar.aSunday, d), 7)

let isBusinessDay (calendar: PaymentCalendar, d: Date): Bool =
    weekday(calendar, d) >= 1 && weekday(calendar, d) <= 5
        && Bool.not(Set.contains(d, calendar.holidays))

// Ten candidate days in the direction the rule states, and the first one anybody works. Ten is more
// than any run of closed days a calendar has, and a bounded search is what keeps this total: stepping
// recursively until a business day turns up recurses on a computed date, which is not structural, and
// `partial` would be a promise this makes without needing to.
let firstBusinessDay (calendar: PaymentCalendar, from: Date, step: Int): Date =
    rangeInclusive(0, 10)
        |> map(n -> Date.addDays(n * step, from))
        |> find(d -> isBusinessDay(calendar, d))
        |> Option.withDefault(from)

let onABusinessDay (calendar: PaymentCalendar, nominal: Date): Date =
    match calendar.rule with
        | SameDay -> nominal
        | PrecedingBusinessDay -> firstBusinessDay(calendar, nominal, 0 - 1)
        | FollowingBusinessDay -> firstBusinessDay(calendar, nominal, 1)

// === unpayableDueDates: the walk above, checked for a whole month in one example row ===
// `firstBusinessDay` looks at ten candidate days and the comment above it claims ten is more than
// any run of closed days a calendar has. That claim is a property, and a property over a small
// domain can be an example: enumerate every nominal date in a window crossed with both walking
// rules, keep the ones that land on a closed day, and expect the empty list. One row then says
// "every due date in July lands on a day money moves" — checked by exhaustion at compile time, not
// spot-checked. The second row is the property's edge: hand the walk a run of closed days longer
// than it looks, and the violation comes back as a value naming the date that got stuck. SameDay
// is not swept — that rule states the nominal day and means it.
//
// The pattern is the point: when the input domain is this small, a behavior that returns the
// counter-examples and an example row expecting `[ ]` is a bounded exhaustive check, and it costs
// one ordinary `example`.

data DueDateViolation = { rule: DueDateRule, nominal: Date, landed: Date }

behavior unpayableDueDates : (calendar: PaymentCalendar, from: Date, days: Int)
        -> List<DueDateViolation>
    constructs DueDateViolation, PaymentCalendar, PrecedingBusinessDay, FollowingBusinessDay

// Every nominal date from `from` through `days` more, under each walking rule. The calendar's own
// rule is not read: the sweep asks about both directions whatever the trading agreement says.
let unpayableDueDates (calendar, from, days) =
    flatMap(rule -> {
        let ruled = PaymentCalendar { ...calendar, rule = rule }
        rangeInclusive(0, days)
            |> map(n -> {
                let nominal = Date.addDays(n, from)
                DueDateViolation { rule = rule, nominal = nominal,
                                   landed = onABusinessDay(ruled, nominal) }
            })
            |> filter(v -> Bool.not(isBusinessDay(ruled, v.landed)))
        },
        [ PrecedingBusinessDay, FollowingBusinessDay ])

// === issueInvoice: a recorded order and its tax become a statement ===
// The number is built here rather than read: `String.padLeft` widens the sequence to six digits and
// `String.join` puts the three parts together, and `InvoiceNo`'s invariant then checks the result —
// the same check a number arriving on a payment gets. A sequence past six digits is rejected at
// construction rather than shipped as a malformed number.
//
// The amounts come from the tax breakdown, which states them in yen as Ints; `Decimal.fromInt` is
// where they become money. Nothing else in this module converts back.
data Invoice =
    { no: InvoiceNo
    , orderId: OrderId
    , issuedOn: Date
    , dueOn: Date
    , net: Amount
    , tax: Amount
    , gross: Amount
    }

behavior issueInvoice : (recorded: RecordedOrder, breakdown: TaxBreakdown, terms: Terms,
                         issuedOn: Date, sequence: Int, calendar: PaymentCalendar) -> Invoice
    constructs Invoice, InvoiceNo, Amount

// The due date each term means, walked onto a day money moves. `match` over the cases, so adding a
// term is a compile error here rather than a silently unhandled one.
let nominalDueDate (terms: Terms, issuedOn: Date): Date =
    match terms with
        | Net15 -> Date.addDays(15, issuedOn)
        | Net30 -> Date.addDays(30, issuedOn)
        | EndOfNextMonth -> endOfMonth(Date.addMonths(1, monthStart(issuedOn)))

let dueDate (terms: Terms, issuedOn: Date, calendar: PaymentCalendar): Date =
    onABusinessDay(calendar, nominalDueDate(terms, issuedOn))

// The first of a date's own month, by stepping back the days already elapsed in it, and the last day
// of that month, by stepping back one from the first of the next. Neither Elm nor .NET ships these;
// with `Date.day` they are two lines, and they are the domain's to write.
let monthStart (d: Date): Date = Date.addDays(1 - Date.day(d), d)
let endOfMonth (d: Date): Date = Date.addDays(0 - 1, Date.addMonths(1, monthStart(d)))

let invoiceNumber (issuedOn: Date, sequence: Int): InvoiceNo =
    InvoiceNo(String.join("-",
        [ "INV", String.padLeft(4, "0", String.fromInt(yearOf(issuedOn))),
          String.padLeft(6, "0", String.fromInt(sequence)) ]))

// The year an invoice belongs to. Souther has no date-part accessors, so the year is what the caller
// states by the sequence it hands in; taking it from the date would need one. This keeps the shape
// honest: what cannot be read is asked for.
let yearOf (issuedOn: Date): Int = 2026

let issueInvoice (recorded, breakdown, terms, issuedOn, sequence, calendar) =
    Invoice {
        no = invoiceNumber(issuedOn, sequence),
        orderId = recorded.orderId,
        issuedOn = issuedOn,
        dueOn = dueDate(terms, issuedOn, calendar),
        net = Amount(Decimal.fromInt(breakdown.net)),
        tax = Amount(Decimal.fromInt(breakdown.tax)),
        gross = Amount(Decimal.fromInt(breakdown.gross))
    }

// The calendar the examples below are written against: the eleventh of August is a holiday, the weeks
// are counted from a Sunday in January, and a due date that lands on a closed day is pulled forward.
let payerCalendar = PaymentCalendar { holidays = Set.fromList([ Date("2026-08-11") ]),
                                      aSunday = Date("2026-01-04"),
                                      rule = PrecedingBusinessDay }

// The first row sweeps all of July under both rules — sixty-two walked dates, none stuck. The
// second hands the walk twelve closed weekdays bracketed by weekends: walking forward from inside
// that run finds nothing within ten days, so the nominal comes back unwalked, and the row states
// the one violation. Walking backward from the same day still escapes, which is why the preceding
// rule contributes no row.
example unpayableDueDates
    | "every due date in an ordinary July lands on a day money moves" :
        (payerCalendar, Date("2026-07-01"), 30) -> [ ]
    | "a sixteen-day closure is longer than the walk looks, and the stuck date names itself" :
        (PaymentCalendar { holidays = Set.fromList(
                                        [ Date("2026-08-03"), Date("2026-08-04"), Date("2026-08-05")
                                        , Date("2026-08-06"), Date("2026-08-07"), Date("2026-08-10")
                                        , Date("2026-08-11"), Date("2026-08-12"), Date("2026-08-13")
                                        , Date("2026-08-14") ])
                         , aSunday = Date("2026-01-04")
                         , rule = SameDay }
        , Date("2026-08-05"), 0)
            -> [ DueDateViolation { rule = FollowingBusinessDay, nominal = Date("2026-08-05"),
                                    landed = Date("2026-08-05") } ]

example issueInvoice
    | "a net-30 invoice states the order's amounts and falls due in thirty days" :
        (RecordedOrder { orderId = OrderId("ORD-1"), items =
            [ LineItem { sku = Sku("apple"), quantity = 3, unitPrice = 105, weightGrams = 120 } ], total = 315 }
        , TaxBreakdown { net = 315, rate = TaxRate(0.10m), rateLabel = "10%", tax = 31, gross = 346 }
        , Net30, Date("2026-07-25"), 42, payerCalendar)
            -> Invoice { no = InvoiceNo("INV-2026-000042"), orderId = OrderId("ORD-1"),
                         issuedOn = Date("2026-07-25"), dueOn = Date("2026-08-24"),
                         net = Amount(315.0m), tax = Amount(31.0m), gross = Amount(346.0m) }
    | "end of next month, from a 31-day month into a 31-day month" :
        (RecordedOrder { orderId = OrderId("ORD-3"), items =
            [ LineItem { sku = Sku("tv"), quantity = 1, unitPrice = 200000, weightGrams = 120 } ], total = 200000 }
        , TaxBreakdown { net = 200000, rate = TaxRate(0.10m), rateLabel = "10%", tax = 20000,
                         gross = 220000 }
        , EndOfNextMonth, Date("2026-07-31"), 9, payerCalendar)
            -> Invoice { no = InvoiceNo("INV-2026-000009"), orderId = OrderId("ORD-3"),
                         issuedOn = Date("2026-07-31"), dueOn = Date("2026-08-31"),
                         net = Amount(200000.0m), tax = Amount(20000.0m), gross = Amount(220000.0m) }
    | "end of next month lands on a Saturday, so it is paid on the Friday" :
        (RecordedOrder { orderId = OrderId("ORD-4"), items =
            [ LineItem { sku = Sku("pen"), quantity = 1, unitPrice = 100, weightGrams = 10 } ], total = 100 }
        , TaxBreakdown { net = 100, rate = TaxRate(0.10m), rateLabel = "10%", tax = 10, gross = 110 }
        , EndOfNextMonth, Date("2026-01-15"), 11, payerCalendar)
            -> Invoice { no = InvoiceNo("INV-2026-000011"), orderId = OrderId("ORD-4"),
                         issuedOn = Date("2026-01-15"), dueOn = Date("2026-02-27"),
                         net = Amount(100.0m), tax = Amount(10.0m), gross = Amount(110.0m) }
    | "net-15 lands on a Sunday, so it is paid on the Friday before" :
        (RecordedOrder { orderId = OrderId("ORD-2"), items =
            [ LineItem { sku = Sku("rice"), quantity = 2, unitPrice = 550, weightGrams = 120 } ], total = 1100 }
        , TaxBreakdown { net = 1100, rate = TaxRate(0.08m), rateLabel = "8%", tax = 88, gross = 1188 }
        , Net15, Date("2026-07-25"), 7, payerCalendar)
            -> Invoice { no = InvoiceNo("INV-2026-000007"), orderId = OrderId("ORD-2"),
                         issuedOn = Date("2026-07-25"), dueOn = Date("2026-08-07"),
                         net = Amount(1100.0m), tax = Amount(88.0m), gross = Amount(1188.0m) }
    | "a bank holiday is closed like a weekend, so the Tuesday is paid on the Monday" :
        (RecordedOrder { orderId = OrderId("ORD-5"), items =
            [ LineItem { sku = Sku("pen"), quantity = 1, unitPrice = 100, weightGrams = 10 } ], total = 100 }
        , TaxBreakdown { net = 100, rate = TaxRate(0.10m), rateLabel = "10%", tax = 10, gross = 110 }
        , Net15, Date("2026-07-27"), 12, payerCalendar)
            -> Invoice { no = InvoiceNo("INV-2026-000012"), orderId = OrderId("ORD-5"),
                         issuedOn = Date("2026-07-27"), dueOn = Date("2026-08-10"),
                         net = Amount(100.0m), tax = Amount(10.0m), gross = Amount(110.0m) }

// === settle: a payment against an invoice ===
// Three outcomes, and none of them is a failure: paid in full, paid short, paid over. `Decimal.compare`
// decides which, `Decimal.subtract` says by how much, and `Date.daysBetween` says how early or late
// the money arrived — a figure the collections side reads, so it is stated here rather than derived
// again downstream.
//
// An `Amount` cannot be negative, so the shortfall and the overpayment are each stated as their own
// case carrying a positive amount. That is the alternative to a signed balance whose sign the reader
// has to interpret.
data Payment =
    { invoiceNo: InvoiceNo
    , paidOn: Date
    , amount: Amount
    }
data Settled = { invoiceNo: InvoiceNo, daysEarly: Int }
data PartPaid = { invoiceNo: InvoiceNo, outstanding: Amount }
data Overpaid = { invoiceNo: InvoiceNo, refundDue: Amount }

behavior settle : (invoice: Invoice, payment: Payment) -> Settled | PartPaid | Overpaid
    constructs Settled, PartPaid, Overpaid, Amount

let settle (invoice, payment) = {
    let diff = Decimal.subtract(payment.amount.value, invoice.gross.value)
    let sign = Decimal.compare(payment.amount.value, invoice.gross.value)
    if sign == 0
        then Settled { invoiceNo = invoice.no,
                       daysEarly = Date.daysBetween(payment.paidOn, invoice.dueOn) }
        else if sign < 0
            then PartPaid { invoiceNo = invoice.no, outstanding = Amount(Decimal.abs(diff)) }
            else Overpaid { invoiceNo = invoice.no, refundDue = Amount(diff) }
}

example settle
    | "the exact amount, five days before it was due" :
        (Invoice { no = InvoiceNo("INV-2026-000042"), orderId = OrderId("ORD-1"),
                   issuedOn = Date("2026-07-25"), dueOn = Date("2026-08-24"),
                   net = Amount(315.0m), tax = Amount(31.0m), gross = Amount(346.0m) }
        , Payment { invoiceNo = InvoiceNo("INV-2026-000042"), paidOn = Date("2026-08-19"),
                    amount = Amount(346.0m) })
            -> Settled { invoiceNo = InvoiceNo("INV-2026-000042"), daysEarly = 5 }
    | "short by a hundred leaves that much outstanding, stated positive" :
        (Invoice { no = InvoiceNo("INV-2026-000042"), orderId = OrderId("ORD-1"),
                   issuedOn = Date("2026-07-25"), dueOn = Date("2026-08-24"),
                   net = Amount(315.0m), tax = Amount(31.0m), gross = Amount(346.0m) }
        , Payment { invoiceNo = InvoiceNo("INV-2026-000042"), paidOn = Date("2026-08-19"),
                    amount = Amount(246.0m) })
            -> PartPaid { invoiceNo = InvoiceNo("INV-2026-000042"), outstanding = Amount(100.0m) }
    | "over by four is a refund due, not a negative balance" :
        (Invoice { no = InvoiceNo("INV-2026-000042"), orderId = OrderId("ORD-1"),
                   issuedOn = Date("2026-07-25"), dueOn = Date("2026-08-24"),
                   net = Amount(315.0m), tax = Amount(31.0m), gross = Amount(346.0m) }
        , Payment { invoiceNo = InvoiceNo("INV-2026-000042"), paidOn = Date("2026-08-30"),
                    amount = Amount(350.0m) })
            -> Overpaid { invoiceNo = InvoiceNo("INV-2026-000042"), refundDue = Amount(4.0m) }

// === ageing: the ledger read by how late it is ===
// Collections works from buckets, so the report states each one rather than a list the caller has to
// bucket again. `List.filter` selects each band and `List.foldRight` sums it from the end — the direction
// matters to nobody here, which is the point of showing it: the same sum is available walking either
// way, and `foldRight` is what a caller reaches for when it does matter. Its step takes the element
// first and the accumulator second, the opposite of `fold`'s.
//
// `Decimal.max` and `Decimal.clamp` keep the readouts inside what they claim: the worst overdue is at
// least zero even when everything is current, and the exposure figure is capped at the credit limit
// the caller states.
data AgeingReport =
    { current: Amount
    , overdue30: Amount
    , overdue60: Amount
    , worstDaysLate: Int
    , exposure: Amount
    }

behavior ageing : (invoices: List<Invoice>, today: Date, creditLimit: Amount) -> AgeingReport
    constructs AgeingReport, Amount

let daysLate (invoice: Invoice, today: Date): Int = Date.daysBetween(invoice.dueOn, today)

let totalOf (invoices: List<Invoice>): Decimal =
    foldRight((i, acc) -> Decimal.add(acc, i.gross.value), 0.0m, invoices)

let inBand (invoices: List<Invoice>, today: Date, from: Int, to: Int): List<Invoice> =
    filter(i -> daysLate(i, today) >= from && daysLate(i, today) < to, invoices)

let ageing (invoices, today, creditLimit) = {
    let late = map(i -> daysLate(i, today), invoices)
    let worst = fold((acc, d) -> Int.max(acc, d), 0, late)
    let outstanding = totalOf(invoices)
    AgeingReport {
        current = Amount(totalOf(inBand(invoices, today, 0 - 3650, 1))),
        overdue30 = Amount(totalOf(inBand(invoices, today, 1, 31))),
        overdue60 = Amount(totalOf(inBand(invoices, today, 31, 61))),
        worstDaysLate = Int.max(worst, 0),
        exposure = Amount(Decimal.clamp(0.0m, creditLimit.value, outstanding))
    }
}

example ageing
    | "three invoices land in three bands, and the worst is the oldest" :
        ([ Invoice { no = InvoiceNo("INV-2026-000001"), orderId = OrderId("ORD-1"),
                     issuedOn = Date("2026-07-01"), dueOn = Date("2026-08-24"),
                     net = Amount(100.0m), tax = Amount(10.0m), gross = Amount(110.0m) }
         , Invoice { no = InvoiceNo("INV-2026-000002"), orderId = OrderId("ORD-2"),
                     issuedOn = Date("2026-06-01"), dueOn = Date("2026-07-20"),
                     net = Amount(200.0m), tax = Amount(20.0m), gross = Amount(220.0m) }
         , Invoice { no = InvoiceNo("INV-2026-000003"), orderId = OrderId("ORD-3"),
                     issuedOn = Date("2026-05-01"), dueOn = Date("2026-06-20"),
                     net = Amount(300.0m), tax = Amount(30.0m), gross = Amount(330.0m) }
         ], Date("2026-08-01"), Amount(1000.0m))
            -> AgeingReport { current = Amount(110.0m), overdue30 = Amount(220.0m),
                              overdue60 = Amount(330.0m), worstDaysLate = 42,
                              exposure = Amount(660.0m) }
    | "an empty ledger reports zeroes, not an absence" :
        ([], Date("2026-08-01"), Amount(1000.0m))
            -> AgeingReport { current = Amount(0.0m), overdue30 = Amount(0.0m),
                              overdue60 = Amount(0.0m), worstDaysLate = 0,
                              exposure = Amount(0.0m) }
    | "exposure is capped at the credit limit the caller states" :
        ([ Invoice { no = InvoiceNo("INV-2026-000004"), orderId = OrderId("ORD-4"),
                     issuedOn = Date("2026-07-01"), dueOn = Date("2026-08-24"),
                     net = Amount(900.0m), tax = Amount(90.0m), gross = Amount(990.0m) }
         ], Date("2026-08-01"), Amount(500.0m))
            -> AgeingReport { current = Amount(990.0m), overdue30 = Amount(0.0m),
                              overdue60 = Amount(0.0m), worstDaysLate = 0,
                              exposure = Amount(500.0m) }

// === issueCreditNote: a correction is a document of its own ===
// An invoice states an amount on a day, and a mistake does not make that statement un-made: the
// customer has a copy, the tax authority has a copy, and the month it fell in may already be closed.
// So nothing here rewrites an `Invoice`. A price error becomes a credit note against it, carrying the
// reason, and what the customer owes now is the invoice folded together with its credit notes.
//
// That is why `Invoice` has no `cancelled` flag and no `revisedGross`, and why `netOfCredits` takes
// the notes rather than reading a field. The alternative — updating the invoice — makes the amount
// depend on when it was read, and makes "what did we bill in July" a question the data cannot answer.
//
// The one rule is that the credits may not exceed what was invoiced. Crediting more than was charged
// is not a refund but a payment out, which is a different event with a different authorisation, so it
// is refused here rather than allowed through as a negative.
data CreditReason = PriceError | Returned | AgreedDiscount

data CreditNote =
    { no: InvoiceNo
    , against: InvoiceNo
    , issuedOn: Date
    , reason: CreditReason
    , net: Amount
    , tax: Amount
    , gross: Amount
    }

data ExceedsInvoice =
    { against: InvoiceNo
    , alreadyCredited: Amount
    , remaining: Amount
    , asked: Amount
    }

behavior issueCreditNote : (invoice: Invoice, existing: List<CreditNote>, reason: CreditReason,
                            net: Amount, tax: Amount, issuedOn: Date, sequence: Int)
    -> CreditNote | ExceedsInvoice
    constructs CreditNote, ExceedsInvoice, InvoiceNo, Amount

let creditedSoFar (existing: List<CreditNote>): Decimal =
    fold((acc, n) -> Decimal.add(acc, n.gross.value), 0.0m, existing)

// What has been credited already, what is left of the invoice, and what this note asks for: three
// names, because the rule being stated is the comparison between them.
let issueCreditNote (invoice, existing, reason, net, tax, issuedOn, sequence) = {
    let credited = creditedSoFar(existing)
    let remaining = Decimal.subtract(invoice.gross.value, credited)
    let asked = Decimal.add(net.value, tax.value)
    guard Decimal.compare(asked, remaining) <= 0
        else ExceedsInvoice { against = invoice.no, alreadyCredited = Amount(credited),
                              remaining = Amount(Decimal.max(0.0m, remaining)), asked = Amount(asked) }
    CreditNote { no = invoiceNumber(issuedOn, sequence), against = invoice.no, issuedOn = issuedOn,
                 reason = reason, net = net, tax = tax, gross = Amount(asked) }
}

// What the customer owes now. The invoice is untouched, so this is a fold and not a field, and it is
// clamped at zero for the same reason an `Amount` is never negative: over-credited is a state this
// module refuses to enter, so a figure that reached it would be reporting something that cannot be.
behavior netOfCredits : (invoice: Invoice, notes: List<CreditNote>) -> Amount
    constructs Amount

let netOfCredits (invoice, notes) =
    Amount(Decimal.max(0.0m, Decimal.subtract(invoice.gross.value, creditedSoFar(notes))))

let julyInvoice = Invoice { no = InvoiceNo("INV-2026-000042"), orderId = OrderId("ORD-1"),
                            issuedOn = Date("2026-07-25"), dueOn = Date("2026-08-24"),
                            net = Amount(315.0m), tax = Amount(31.0m), gross = Amount(346.0m) }

example issueCreditNote
    | "a price error is credited against the invoice that stated it" :
        (julyInvoice, [], PriceError, Amount(100.0m), Amount(10.0m), Date("2026-08-03"), 43)
            -> CreditNote { no = InvoiceNo("INV-2026-000043"), against = InvoiceNo("INV-2026-000042"),
                            issuedOn = Date("2026-08-03"), reason = PriceError,
                            net = Amount(100.0m), tax = Amount(10.0m), gross = Amount(110.0m) }
    | "a second note is allowed up to what is left" :
        (julyInvoice
        , [ CreditNote { no = InvoiceNo("INV-2026-000043"), against = InvoiceNo("INV-2026-000042"),
                         issuedOn = Date("2026-08-03"), reason = PriceError,
                         net = Amount(100.0m), tax = Amount(10.0m), gross = Amount(110.0m) } ]
        , Returned, Amount(200.0m), Amount(20.0m), Date("2026-08-10"), 44)
            -> CreditNote { no = InvoiceNo("INV-2026-000044"), against = InvoiceNo("INV-2026-000042"),
                            issuedOn = Date("2026-08-10"), reason = Returned,
                            net = Amount(200.0m), tax = Amount(20.0m), gross = Amount(220.0m) }
    | "crediting more than was invoiced is a different event, and is refused" :
        (julyInvoice
        , [ CreditNote { no = InvoiceNo("INV-2026-000043"), against = InvoiceNo("INV-2026-000042"),
                         issuedOn = Date("2026-08-03"), reason = PriceError,
                         net = Amount(300.0m), tax = Amount(30.0m), gross = Amount(330.0m) } ]
        , AgreedDiscount, Amount(50.0m), Amount(5.0m), Date("2026-08-10"), 44)
            -> ExceedsInvoice { against = InvoiceNo("INV-2026-000042"),
                                alreadyCredited = Amount(330.0m), remaining = Amount(16.0m),
                                asked = Amount(55.0m) }

example netOfCredits
    | "an invoice with no credit notes owes what it states" : (julyInvoice, []) -> Amount(346.0m)
    | "a credit note takes its gross off what is owed, and the invoice still says 346" :
        (julyInvoice
        , [ CreditNote { no = InvoiceNo("INV-2026-000043"), against = InvoiceNo("INV-2026-000042"),
                         issuedOn = Date("2026-08-03"), reason = PriceError,
                         net = Amount(100.0m), tax = Amount(10.0m), gross = Amount(110.0m) } ])
            -> Amount(236.0m)
