// Articles: what one is, how its slug is made, and who may change it.
//
// An Article is an ArticleSummary with its body. The layering is a fact about the read rather than
// about the JSON: the listing endpoints do not select the body column, so what they answer is a list
// of summaries, and a summary is the whole value rather than an article with a field left out.
//
// The author is a Profile rather than a Username. An article's author is a person, and the alternative
// — holding the id and asking the boundary to look the person up per row — is the same choice made
// worse. What the boundary still adds is `following`, which is about whoever is reading.
module blog.articles exposing (
    Slug,
    Title,
    Description,
    Body,
    Tag,
    ArticleSummary,
    Article,
    ArticleDraft,
    ArticleChange,
    SlugTaken,
    TitleHasNoSlug,
    NotTheAuthor,
    ArticleNotFound,
    Removed,
    removeArticle,
    deleteArticle,
    Limit,
    Offset,
    Paging,
    GlobalQuery,
    FeedQuery,
    ArticleQuery,
    ArticlePage,
    FavoritedSlugs,
    FavoriteCounts,
    slugExists,
    storeArticle,
    createArticle,
    updateArticle,
    readArticles,
    readArticle,
    readFavorited,
    readFavoriteCounts,
    storeFavorite,
    storeUnfavorite,
    TagList,
    readTags
)
import blog.identity ( Profile, Username )
import String ( lowercase, characters, concat, words, join )

data Slug = String
    invariant String.matches("[a-z0-9]+(-[a-z0-9]+)*", value)

data Title = String
    invariant String.length(value) >= 1 && String.length(value) <= 255

data Description = String

data Body = String

data Tag = String
    invariant String.length(value) >= 1 && String.length(value) <= 60

data ArticleSummary =
    { slug: Slug
    , title: Title
    , description: Description
    , tagList: List<Tag>
    , author: Profile
    , createdAt: DateTime
    , updatedAt: DateTime
    }

data Article = { ...ArticleSummary, body: Body }

// What a client sends to write an article, plus the two things it does not decide: who is writing and
// when. The boundary supplies those, because a client claiming either would be a client the domain
// believed.
data ArticleDraft =
    { title: Title
    , description: Description
    , body: Body
    , tagList: List<Tag>
    , author: Profile
    , at: DateTime
    }

// A change sends whatever it changes and leaves the rest out, so every editable field is optional.
data ArticleChange =
    { title: Title?
    , description: Description?
    , body: Body?
    , at: DateTime
    }

// === the slug ===
// Lowercase, then every run of characters that is not a letter or a digit becomes a break, and the
// pieces are joined with hyphens. slugText answers a String rather than a Slug because a title made
// only of punctuation has no slug at all, and Slug's invariant would abort on it — so the emptiness
// is discharged by a guard in createArticle and the newtype is built after it.
let slugText (title: Title): String =
    title.value
        |> lowercase
        |> characters
        |> List.map(c -> if String.matches("[a-z0-9]", c) then c else " ")
        |> concat
        |> words
        |> join("-")

behavior slugExists   : (slug: Slug) -> Bool
behavior storeArticle : (article: Article) -> Article

// A title with no slug in it is a domain outcome rather than an abort: the client sent something, and
// what it sent cannot name an article.
behavior createArticle : (draft: ArticleDraft) -> Article | SlugTaken | TitleHasNoSlug
    depends on slugExists, storeArticle

let createArticle (draft, slugExists, storeArticle) = {
    let text = slugText(draft.title)
    guard String.length(text) >= 1 else TitleHasNoSlug

    let slug = Slug(text)
    guard slugExists(slug) == false else SlugTaken

    storeArticle(Article { slug = slug
                         , title = draft.title
                         , description = draft.description
                         , tagList = draft.tagList
                         , author = draft.author
                         , createdAt = draft.at
                         , updatedAt = draft.at
                         , body = draft.body })
}

// === editing ===
// Only the author may edit, and that is a returned case rather than a thrown 403: the boundary folds
// it into a status, and a behavior that took an editor and ignored them would be a rule nobody states.
//
// The slug does not move when the title does. A slug is how an article is addressed, and links that
// already point at it are not the domain's to break.
behavior updateArticle : (article: Article, editor: Username, change: ArticleChange) -> Article | NotTheAuthor
    depends on storeArticle

let updateArticle (article, editor, change, storeArticle) = {
    guard editor == article.author.username else NotTheAuthor

    storeArticle(Article { ...article
                         , title = changedTitle(change, article.title)
                         , description = changedDescription(change, article.description)
                         , body = changedBody(change, article.body)
                         , updatedAt = change.at })
}

let changedTitle (change: ArticleChange, current: Title): Title =
    match change.title with
        | None    -> current
        | Some t   -> t

let changedDescription (change: ArticleChange, current: Description): Description =
    match change.description with
        | None    -> current
        | Some d   -> d

let changedBody (change: ArticleChange, current: Body): Body =
    match change.body with
        | None    -> current
        | Some b   -> b

// Deleting carries the same rule as editing and answers it the same way, so the two read alike. A
// boundary that checked the author itself for one and asked the domain for the other would be stating
// one rule in two places.
behavior removeArticle : (article: Article) -> Removed

behavior deleteArticle : (article: Article, remover: Username) -> Removed | NotTheAuthor
    depends on removeArticle

let deleteArticle (article, remover, removeArticle) = {
    guard remover == article.author.username else NotTheAuthor
    removeArticle(article)
}

// === asking for a page of articles ===
// A search is a value. Limit and Offset carry their bounds as invariants, so a request for a page of
// a thousand rows is refused by the decoder and the SQL is never shown one — the bound is stated once,
// in the domain, rather than defended in each query the boundary writes.
//
// The global list and the personal feed are two cases rather than one query with a nullable field,
// because they ask different questions. A feed is the articles of the people you follow, and there is
// no tag or author to filter it by; a global list has no followees. A single flat query would make
// both of those representable at once, and nothing would mean anything.
data Limit = Int
    invariant value >= 1 && value <= 100

data Offset = Int
    invariant value >= 0

data Paging = { limit: Limit, offset: Offset }

data GlobalQuery = { ...Paging, tag: Tag?, author: Username?, favoritedBy: Username? }
data FeedQuery   = { ...Paging, followees: Set<Username> }

data ArticleQuery = GlobalQuery | FeedQuery

// The page and the total are read together because they answer one question. `total` is how many the
// query matches, not how many this page holds — a client paging through needs the first.
data ArticlePage = { articles: List<ArticleSummary>, total: Int }

behavior readArticles : (query: ArticleQuery) -> ArticlePage
    ensures List.length(value.articles) <= query.limit.value
    ensures List.all(article -> matchesQuery(query, article), value.articles)

// What a query asks of every article it is answered with. The rows say what ten particular queries
// answer; this says what any query answers, and it is the sentence the `where` underneath is an
// assembly of. A test can hold the SQL to it without anybody writing the page out.
//
// `favoritedBy` is not read here and cannot be: an ArticleSummary carries no favouriting, so there
// is nothing in the answer to hold to that filter. A page filtered only on it keeps this clause
// without the clause having borne on it.
let matchesQuery (query: ArticleQuery, article: ArticleSummary): Bool =
    match query with
        | GlobalQuery as global ->
            carriesTag(global, article) && writtenBy(global, article)
        | FeedQuery as feed ->
            Set.contains(article.author.username, feed.followees)

let carriesTag (query: GlobalQuery, article: ArticleSummary): Bool =
    match query.tag with
        | None   -> true
        | Some t -> List.contains(t, article.tagList)

let writtenBy (query: GlobalQuery, article: ArticleSummary): Bool =
    match query.author with
        | None   -> true
        | Some a -> article.author.username == a

behavior readArticle : (slug: Slug) -> Article | ArticleNotFound

// Which of a page's articles the viewer has favorited, and how many favorites each has. Both are read
// once for the whole page: the first is about the viewer, the second is about the articles, and asking
// either per row is the query-per-article this shape exists to avoid.
data FavoritedSlugs = { slugs: Set<Slug> }
data FavoriteCounts = { counts: Map<Slug, Int> }

behavior readFavorited      : (viewer: Username) -> FavoritedSlugs
behavior readFavoriteCounts : (slugs: List<Slug>) -> FavoriteCounts

// Favoriting has no rule to state — anybody logged in may favorite anything, twice included — so
// these are writes the boundary calls, with no composed behavior wrapping them. Favoriting twice is
// favoriting once, which the store's key enforces rather than a guard here.
behavior storeFavorite   : (viewer: Username, slug: Slug) -> FavoritedSlugs
behavior storeUnfavorite : (viewer: Username, slug: Slug) -> FavoritedSlugs

// Every tag any article carries. Nothing narrows it, so it takes no argument.
data TagList = { tags: List<Tag> }

behavior readTags : () -> TagList

// === fake + example ===
let jake = Profile { username = Username("jake"), bio = None, image = None }

let dragons = Article
    { slug = Slug("how-to-train-your-dragon")
    , title = Title("How to train your dragon")
    , description = Description("Ever wonder how?")
    , tagList = [ Tag("dragons"), Tag("training") ]
    , author = jake
    , createdAt = DateTime("2026-08-06T03:22:56")
    , updatedAt = DateTime("2026-08-06T03:22:56")
    , body = Body("It takes a Jacobian")
    }

let everWonder = Article
    { ...dragons
    , slug = Slug("ever-wonder-how-really")
    , title = Title("Ever wonder... how??  Really")
    , description = Description("d")
    , tagList = []
    , body = Body("b")
    }

let retitled = Article
    { ...dragons
    , title = Title("How to train your dragon, again")
    , updatedAt = DateTime("2026-08-06T04:00:00")
    }

let retimed = Article { ...dragons, updatedAt = DateTime("2026-08-06T04:00:00") }

fake slugExists
    | (Slug("how-to-train-your-dragon")) -> false
    | (Slug("taken")) -> true
    | _ -> false

// The same two inputs the table above states, written as what `slugExists` owes rather than as what
// stands in for it. Until these were here the table was held to nothing: ADR-0093 compares a `fake`
// with its behavior's recorded rows and reports a disagreement, and `slugExists` had no rows for it
// to reach. What the two texts now say is one thing, and `ReadArticlesDifferentialTest` is where an
// implementation is held to both of them at once.
//
// They describe a world rather than a moment: `taken` names an article and `how-to-train-your-dragon`
// does not. That world is the test's to arrange, which is why the same entry reads `AsStated` under
// it and `OtherThanStated` under another.
example slugExists
    | "a slug no article is stored under is free" :
        (Slug("how-to-train-your-dragon")) -> false
    | "a slug an article already carries is taken" :
        (Slug("taken")) -> true

// A person with everything a profile can say, so a row that carries one shows the bio and the image
// arriving in the answer rather than being dropped on the way.
let jakeInFull = Profile
    { username = Username("jake")
    , bio = blog.identity.Bio("Trains dragons")
    , image = blog.identity.ImageUrl("https://example.com/jake.png")
    }

let profiled = Article { ...dragons, author = jakeInFull }

let later = DateTime("2026-08-06T04:00:00")

// The shortest title and tag the invariants admit, and the longest. The slug is made from the title
// alone, so a one-letter title is a one-letter slug and a 255-letter one is a 255-letter slug.
let shortest = Article
    { slug = Slug("d")
    , title = Title("D")
    , description = Description("d")
    , tagList = [ Tag("t") ]
    , author = jakeInFull
    , createdAt = DateTime("2026-08-06T05:00:00")
    , updatedAt = DateTime("2026-08-06T05:00:00")
    , body = Body("b")
    }

let longest = Article
    { slug = Slug(String.repeat(255, "a"))
    , title = Title(String.repeat(255, "A"))
    , description = Description("d")
    , tagList = [ Tag(String.repeat(60, "t")) ]
    , author = jake
    , createdAt = DateTime("2026-08-06T05:00:00")
    , updatedAt = DateTime("2026-08-06T05:00:00")
    , body = Body("b")
    }

// What each way of sending some of the three editable fields leaves behind. A field that was sent
// replaces the stored one, and a field that was not sent stays as it was.
let byBody = Article { ...profiled, body = Body("It takes a Jacobian and patience"), updatedAt = later }

let byDescription = Article
    { ...profiled, description = Description("A Jacobian, mostly"), updatedAt = later }

let byDescriptionAndBody = Article
    { ...profiled
    , description = Description("A Jacobian, mostly")
    , body = Body("It takes a Jacobian and patience")
    , updatedAt = later
    }

let byTitleAndBody = Article
    { ...profiled
    , title = Title("How to train your dragon, again")
    , body = Body("It takes a Jacobian and patience")
    , updatedAt = later
    }

let byTitleAndDescription = Article
    { ...profiled
    , title = Title("How to train your dragon, again")
    , description = Description("A Jacobian, mostly")
    , updatedAt = later
    }

let byAllThree = Article
    { ...profiled
    , title = Title("How to train your dragon, again")
    , description = Description("A Jacobian, mostly")
    , body = Body("It takes a Jacobian and patience")
    , updatedAt = later
    }

// A write answers what it stored, so the table is the identity over the articles these rows build.
fake storeArticle
    | (dragons)               -> dragons
    | (everWonder)            -> everWonder
    | (retitled)              -> retitled
    | (retimed)               -> retimed
    | (shortest)              -> shortest
    | (longest)               -> longest
    | (byBody)                -> byBody
    | (byDescription)         -> byDescription
    | (byDescriptionAndBody)  -> byDescriptionAndBody
    | (byTitleAndBody)        -> byTitleAndBody
    | (byTitleAndDescription) -> byTitleAndDescription
    | (byAllThree)            -> byAllThree
    | (profiled)              -> profiled
    | (withBio)               -> withBio
    | (withImage)             -> withImage
    | _                       -> dragons

example createArticle
    | "a title becomes a hyphenated slug" :
        (ArticleDraft { title = Title("How to train your dragon")
                      , description = Description("Ever wonder how?")
                      , body = Body("It takes a Jacobian")
                      , tagList = [ Tag("dragons"), Tag("training") ]
                      , author = jake
                      , at = DateTime("2026-08-06T03:22:56") })
        -> dragons
    | "punctuation and repeated spaces collapse into single hyphens" :
        (ArticleDraft { title = Title("Ever wonder... how??  Really")
                      , description = Description("d")
                      , body = Body("b")
                      , tagList = []
                      , author = jake
                      , at = DateTime("2026-08-06T03:22:56") })
        -> everWonder
    | "a title with nothing but punctuation names no article" :
        (ArticleDraft { title = Title("???")
                      , description = Description("d")
                      , body = Body("b")
                      , tagList = []
                      , author = jake
                      , at = DateTime("2026-08-06T03:22:56") })
        -> TitleHasNoSlug
    | "a slug an article already carries is taken, and nothing is written" :
        (ArticleDraft { title = Title("Taken")
                      , description = Description("d")
                      , body = Body("b")
                      , tagList = []
                      , author = jake
                      , at = DateTime("2026-08-06T03:22:56") })
        -> SlugTaken
    | "the shortest title and tag are kept, and the author's bio and image come along" :
        (ArticleDraft { title = Title("D")
                      , description = Description("d")
                      , body = Body("b")
                      , tagList = [ Tag("t") ]
                      , author = jakeInFull
                      , at = DateTime("2026-08-06T05:00:00") })
        -> shortest
    | "the longest title and tag are kept, and the slug is as long as the title" :
        (ArticleDraft { title = Title(String.repeat(255, "A"))
                      , description = Description("d")
                      , body = Body("b")
                      , tagList = [ Tag(String.repeat(60, "t")) ]
                      , author = jake
                      , at = DateTime("2026-08-06T05:00:00") })
        -> longest

example updateArticle
    | "the author may change the title, and the slug does not move" :
        (dragons, Username("jake"), ArticleChange { title = Title("How to train your dragon, again")
                                                  , description = None
                                                  , body = None
                                                  , at = DateTime("2026-08-06T04:00:00") })
        -> retitled
    | "a change that sends nothing still moves the time it was changed" :
        (dragons, Username("jake"), ArticleChange { title = None, description = None, body = None
                                                  , at = DateTime("2026-08-06T04:00:00") })
        -> retimed
    | "somebody who is not the author may not change it" :
        (dragons, Username("gerome"), ArticleChange { title = Title("Mine now")
                                                    , description = None, body = None
                                                    , at = DateTime("2026-08-06T04:00:00") })
        -> NotTheAuthor
    | "a body sent alone replaces the body and nothing else" :
        (profiled, Username("jake"), ArticleChange { title = None, description = None
                                                   , body = Body("It takes a Jacobian and patience")
                                                   , at = later })
        -> byBody
    | "a description sent alone replaces the description and nothing else" :
        (profiled, Username("jake"), ArticleChange { title = None
                                                   , description = Description("A Jacobian, mostly")
                                                   , body = None, at = later })
        -> byDescription
    | "a description and a body sent together replace both, and the title stays" :
        (profiled, Username("jake"), ArticleChange { title = None
                                                   , description = Description("A Jacobian, mostly")
                                                   , body = Body("It takes a Jacobian and patience")
                                                   , at = later })
        -> byDescriptionAndBody
    | "a title and a body sent together replace both, and the description stays" :
        (profiled, Username("jake"), ArticleChange { title = Title("How to train your dragon, again")
                                                   , description = None
                                                   , body = Body("It takes a Jacobian and patience")
                                                   , at = later })
        -> byTitleAndBody
    | "a title and a description sent together replace both, and the body stays" :
        (profiled, Username("jake"), ArticleChange { title = Title("How to train your dragon, again")
                                                   , description = Description("A Jacobian, mostly")
                                                   , body = None, at = later })
        -> byTitleAndDescription
    | "all three sent replace all three, and the slug still does not move" :
        (profiled, Username("jake"), ArticleChange { title = Title("How to train your dragon, again")
                                                   , description = Description("A Jacobian, mostly")
                                                   , body = Body("It takes a Jacobian and patience")
                                                   , at = later })
        -> byAllThree

fake removeArticle
    | _ -> Removed

example deleteArticle
    | "the author may delete it" :
        (dragons, Username("jake")) -> Removed
    | "somebody who is not the author may not" :
        (dragons, Username("gerome")) -> NotTheAuthor
    | "an author with a bio and an image may delete it" :
        (profiled, Username("jake")) -> Removed


// === asking for a page: the rows a bound implementation is held to ===
// These are the first rows in this repository written for an injected behavior. Nothing here can run
// them at compile time — there is no `let` to run and a `fake` would only be answering itself. They
// are a record of what `readArticles` owes, and what runs them is `ReadArticlesExamplesTest`, which
// binds the jOOQ implementation and holds it to each one.
//
// Why this behavior and not one of the other twenty-four injected ones: its input is a sum of two
// shapes and three optional filters, so the SQL underneath is assembled differently for every
// combination. That is the code a reader cannot check by reading, and it is where the combinations
// below earn their keep — each names a way the assembly goes wrong that still reads correctly.
//
// One world, seeded by the test to match: jake wrote two articles tagged `dragons`, gerome wrote one
// tagged `fp`, and gerome favorited one of jake's. Every row is true of that world, because a row
// carries its inputs and its expectation and not the world it is asked in.
let gerome = Profile { username = Username("gerome"), bio = None, image = None }

let dragonsAreReal = ArticleSummary
    { slug = Slug("dragons-are-real")
    , title = Title("Dragons are real")
    , description = Description("They are")
    , tagList = [ Tag("dragons") ]
    , author = jake
    , createdAt = DateTime("2026-08-06T04:00:00")
    , updatedAt = DateTime("2026-08-06T04:00:00")
    }

let trainYourDragon = ArticleSummary
    { slug = Slug("how-to-train-your-dragon")
    , title = Title("How to train your dragon")
    , description = Description("Ever wonder how?")
    , tagList = [ Tag("dragons"), Tag("training") ]
    , author = jake
    , createdAt = DateTime("2026-08-06T03:22:56")
    , updatedAt = DateTime("2026-08-06T03:22:56")
    }

let onFunctionalProgramming = ArticleSummary
    { slug = Slug("on-functional-programming")
    , title = Title("On functional programming")
    , description = Description("A monad is")
    , tagList = [ Tag("fp") ]
    , author = gerome
    , createdAt = DateTime("2026-08-06T02:00:00")
    , updatedAt = DateTime("2026-08-06T02:00:00")
    }

// The unfiltered first page. Every global row below spreads this and names only what it changes, so
// what a row is about is the one line that differs from it.
let firstPage = GlobalQuery
    { limit = Limit(20), offset = Offset(0), tag = None, author = None, favoritedBy = None }

example readArticles
    | "no filter lists every article, newest first" :
        (firstPage)
        -> ArticlePage { articles = [dragonsAreReal, trainYourDragon, onFunctionalProgramming]
                       , total = 3 }
    | "a tag narrows to the articles carrying it" :
        (GlobalQuery { ...firstPage, tag = Tag("dragons") })
        -> ArticlePage { articles = [dragonsAreReal, trainYourDragon], total = 2 }
    | "an author narrows to what they wrote" :
        (GlobalQuery { ...firstPage, author = Username("jake") })
        -> ArticlePage { articles = [dragonsAreReal, trainYourDragon], total = 2 }
    | "two filters narrow together, so one nobody satisfies matches nothing" :
        (GlobalQuery { ...firstPage, tag = Tag("dragons"), author = Username("gerome") })
        -> ArticlePage { articles = [], total = 0 }
    | "two filters one article satisfies keeps that article" :
        (GlobalQuery { ...firstPage, tag = Tag("dragons"), author = Username("jake") })
        -> ArticlePage { articles = [dragonsAreReal, trainYourDragon], total = 2 }
    | "favoritedBy is who favorited it, not who wrote it" :
        (GlobalQuery { ...firstPage, favoritedBy = Username("gerome") })
        -> ArticlePage { articles = [trainYourDragon], total = 1 }
    | "total is how many the query matched, not how many this page holds" :
        (GlobalQuery { ...firstPage, tag = Tag("dragons"), limit = Limit(1) })
        -> ArticlePage { articles = [dragonsAreReal], total = 2 }
    | "the second page carries the next one, not the first again" :
        (GlobalQuery { ...firstPage, tag = Tag("dragons"), limit = Limit(1), offset = Offset(1) })
        -> ArticlePage { articles = [trainYourDragon], total = 2 }
    | "a feed is the articles of the people followed" :
        (FeedQuery { limit = Limit(20), offset = Offset(0)
                   , followees = Set.singleton(Username("jake")) })
        -> ArticlePage { articles = [dragonsAreReal, trainYourDragon], total = 2 }
    | "a feed of nobody is empty, not everything" :
        (FeedQuery { limit = Limit(20), offset = Offset(0), followees = Set.empty })
        -> ArticlePage { articles = [], total = 0 }
    | "a tag and a favoriter together keep what carries the tag and was favorited" :
        (GlobalQuery { ...firstPage, tag = Tag("dragons"), favoritedBy = Username("gerome") })
        -> ArticlePage { articles = [trainYourDragon], total = 1 }
    | "an author and a favoriter together keep what the author wrote and was favorited" :
        (GlobalQuery { ...firstPage, author = Username("jake"), favoritedBy = Username("gerome") })
        -> ArticlePage { articles = [trainYourDragon], total = 1 }
    | "the largest page the limit admits lists everything there is" :
        (GlobalQuery { ...firstPage, limit = Limit(100) })
        -> ArticlePage { articles = [dragonsAreReal, trainYourDragon, onFunctionalProgramming]
                       , total = 3 }


// === the rest of the contract with the articles tables ===
// Rows for the other injected behaviors, each asked in the world readArticles is asked in: jake wrote
// dragons-are-real and how-to-train-your-dragon, gerome wrote on-functional-programming and favorited
// the second of jake's, and the tags in use are dragons, fp and training. Here gerome has also said
// everything a profile can say, and the body of how-to-train-your-dragon is the one `dragons` carries.
let geromeInFull = Profile
    { username = Username("gerome")
    , bio = blog.identity.Bio("Writes monads")
    , image = blog.identity.ImageUrl("https://example.com/gerome.png")
    }

let functional = Article
    { slug = Slug("on-functional-programming")
    , title = Title("On functional programming")
    , description = Description("A monad is")
    , tagList = [ Tag("fp") ]
    , author = geromeInFull
    , createdAt = DateTime("2026-08-06T02:00:00")
    , updatedAt = DateTime("2026-08-06T02:00:00")
    , body = Body("A burrito")
    }

let withBio   = Article { ...dragons, author = Profile { ...jake, bio = blog.identity.Bio("Trains dragons") } }
let withImage = Article
    { ...dragons, author = Profile { ...jake, image = blog.identity.ImageUrl("https://example.com/jake.png") } }

example readArticle
    | "a stored slug reads its article, with its tags and the whole of its author" :
        (Slug("how-to-train-your-dragon")) -> dragons
    | "an author's bio and image arrive with the article" :
        (Slug("on-functional-programming")) -> functional
    | "a slug no article is stored under is not found" :
        (Slug("nobody-wrote-this")) -> ArticleNotFound

// An update that matches a slug is an update and one that matches none is an insert, and either way
// the article asked for is the article answered. The rows are the ones where the author differs only
// in what the profile says, because that is what the store does not write: the author column holds a
// name and the profile is read back from the users table.
example storeArticle
    | "a new article is inserted and answered as stored" : (everWonder) -> everWonder
    | "an article already stored is updated and answered as stored" : (retitled) -> retitled
    | "an author's bio and image are answered with the article" : (profiled) -> profiled
    | "a bio without an image is answered as that" :
        (withBio) -> withBio
    | "an image without a bio is answered as that" :
        (withImage) -> withImage

example removeArticle
    | "the article goes, with its tags and its favorites" : (dragons) -> Removed
    | "an author's bio and image do not change that" : (profiled) -> Removed
    | "a bio without an image removes it all the same" :
        (withBio) -> Removed
    | "an image without a bio removes it all the same" :
        (withImage) -> Removed
    | "an article that is already gone is removed all the same, and is no error" :
        (everWonder) -> Removed

example readFavorited
    | "the slugs the viewer favorited are read at once" :
        (Username("gerome")) -> FavoritedSlugs { slugs = [ Slug("how-to-train-your-dragon") ] }
    | "a viewer who favorited nothing reads an empty set" :
        (Username("jake")) -> FavoritedSlugs { slugs = [] }

example readFavoriteCounts
    | "each slug asked about is counted, and one nobody favorited is counted as zero" :
        ([ Slug("how-to-train-your-dragon"), Slug("dragons-are-real") ])
        -> FavoriteCounts { counts = Map.fromList([ (Slug("how-to-train-your-dragon"), 1)
                                                  , (Slug("dragons-are-real"), 0) ]) }
    | "no slugs asked about is no counts" : ([]) -> FavoriteCounts { counts = Map.empty }

example storeFavorite
    | "a new favorite joins the viewer's set" :
        (Username("gerome"), Slug("dragons-are-real"))
        -> FavoritedSlugs { slugs = [ Slug("how-to-train-your-dragon"), Slug("dragons-are-real") ] }
    | "favoriting twice is favoriting once" :
        (Username("gerome"), Slug("how-to-train-your-dragon"))
        -> FavoritedSlugs { slugs = [ Slug("how-to-train-your-dragon") ] }
    | "the first favorite of a viewer makes the set of one" :
        (Username("jake"), Slug("dragons-are-real"))
        -> FavoritedSlugs { slugs = [ Slug("dragons-are-real") ] }

example storeUnfavorite
    | "the favorite is removed and what is left is answered" :
        (Username("gerome"), Slug("how-to-train-your-dragon")) -> FavoritedSlugs { slugs = [] }
    | "unfavoriting what was never favorited removes nothing and is no error" :
        (Username("gerome"), Slug("dragons-are-real"))
        -> FavoritedSlugs { slugs = [ Slug("how-to-train-your-dragon") ] }
    | "a viewer with no favorites unfavorites into the empty set" :
        (Username("jake"), Slug("dragons-are-real")) -> FavoritedSlugs { slugs = [] }

example readTags
    | "every tag any article carries is read once, in order" :
        () -> TagList { tags = [ Tag("dragons"), Tag("fp"), Tag("training") ] }
