// Identity: who somebody is, how they prove it, and who they follow.
//
// exposing has two readers here, which is why it is long. The other .sou modules need very little —
// articles and comments only have to say who wrote something, so Profile and the types it carries.
// The Java boundary needs the rest: an injected behavior's implementation lives outside this module
// and writes its input and output types when it overrides apply, so every type on the edge of one is
// on this list. A module with no exposing at all exports nothing, which is why the list exists rather
// than being omitted as issuetracker's is.
module blog.identity exposing (
    Username,
    Email,
    Password,
    PasswordHash,
    Bio,
    ImageUrl,
    Profile,
    User,
    Registration,
    Credentials,
    Credentialed,
    Followees,
    UserNotFound,
    EmailTaken,
    UsernameTaken,
    InvalidCredentials,
    CannotFollowSelf,
    hashPassword,
    verifyPassword,
    findUserByEmail,
    findUserByName,
    findLogin,
    storeUser,
    storeUserUpdate,
    storePassword,
    readFollowees,
    storeFollow,
    storeUnfollow,
    registerUser,
    loginUser,
    updateUser,
    follow
)

data Username = String
    invariant String.length(value) >= 1 && String.length(value) <= 40

// The email format check follows crm.sou's EmailAddress: String.matches takes the pattern first
// and the value second, and the match is already anchored to the whole string, so no ^ / $.
data Email = String
    invariant String.matches("[^@\\s]+@[^@\\s]+\\.[^@\\s]+", value)

data Password = String
    invariant String.length(value) >= 8

data PasswordHash = String
    invariant String.length(value) >= 1

data Bio = String

data ImageUrl = String

data Profile = { username: Username, bio: Bio?, image: ImageUrl? }

// A User is a Profile with the email nobody else sees. It does not carry the password hash: a User
// is what a response is built from, and a derived encoder writes every field it is given, so a hash
// on this type is a hash one careless boundary writes into JSON. The hash travels beside the user
// instead, which is why storeUser takes both and findCredentials answers the hash on its own.
data User = { ...Profile, email: Email }

data Registration = { username: Username, email: Email, password: Password }

// === the injected outside-world behaviors ===
// No `let`, so the implementation comes from the boundary. Hashing is one of them: the domain states
// what a password must be (Password's invariant) and never learns how one is stored, so bcrypt is a
// bean in the Java boundary rather than a rule here. UserNotFound, EmailTaken and UsernameTaken carry
// no fields and have no `data` line — naming them in an output is what declares them (8.4 unit-data).
//
// hashPassword has no row. bcrypt draws a fresh salt on every call, so the same password hashes to a
// different string each time and a row could only name one of them. What the output owes, that
// verifyPassword accepts it for the password it came from, is a property of the pair, and the rows
// for verifyPassword state it from the other side with hashes that are fixed.
behavior hashPassword : (password: Password) -> PasswordHash

behavior findUserByEmail : (email: Email) -> User | UserNotFound

behavior findUserByName : (username: Username) -> User | UserNotFound

// Writes a new user and the hash of its password, and answers the user as stored.
behavior storeUser : (user: User, hash: PasswordHash) -> User

// === registerUser: the two names that must be free, then the write ===
// Both uniqueness rules are checked before anything is written, and each has its own case, so the
// boundary can say which name was taken rather than reporting one failure for two causes.
behavior registerUser : (registration: Registration) -> User | EmailTaken | UsernameTaken
    depends on findUserByEmail, findUserByName, hashPassword, storeUser

let registerUser (registration, findUserByEmail, findUserByName, hashPassword, storeUser) =
    match findUserByEmail(registration.email) with
        | User -> EmailTaken
        | UserNotFound ->
            match findUserByName(registration.username) with
                | User -> UsernameTaken
                | UserNotFound ->
                    storeUser(
                        User { username = registration.username
                             , bio = None
                             , image = None
                             , email = registration.email },
                        hashPassword(registration.password))

// === fake + example: the order of the two checks, with no database ===
let jake = User { username = Username("jake"), bio = None, image = None
                , email = Email("jake@jake.jake") }

// The users table the rows below are asked in: jake, who has said nothing about himself, and gerome,
// who has said everything. The lookups are exact, so an address or a name is found only when it is
// written the way it is stored.
let gerome = User
    { username = Username("gerome"), bio = Bio("Writes monads")
    , image = ImageUrl("https://example.com/gerome.png"), email = Email("gerome@jake.jake") }

let newcomer = User { username = Username("newcomer"), bio = None, image = None
                    , email = Email("newcomer@example.com") }

fake findUserByEmail
    | (Email("jake@jake.jake")) -> jake
    | (Email("gerome@jake.jake")) -> gerome
    | _ -> UserNotFound

fake findUserByName
    | (Username("jake")) -> jake
    | (Username("gerome")) -> gerome
    | _ -> UserNotFound

example findUserByEmail
    | "an address the table holds finds its user" : (Email("jake@jake.jake")) -> jake
    | "a user's bio and image come back with them" : (Email("gerome@jake.jake")) -> gerome
    | "an address nobody holds is not found" : (Email("nobody@example.com")) -> UserNotFound

example findUserByName
    | "a name the table holds finds its user" : (Username("jake")) -> jake
    | "a user's bio and image come back with them" : (Username("gerome")) -> gerome
    | "a name nobody holds is not found" : (Username("nobody")) -> UserNotFound

fake hashPassword
    | _ -> PasswordHash("$2a$10$fake")

let newcomerInFull    = User { ...newcomer, bio = Bio("Trains dragons"), image = ImageUrl("https://example.com/n.png") }
let newcomerWithBio   = User { ...newcomer, bio = Bio("Trains dragons") }
let newcomerWithImage = User { ...newcomer, image = ImageUrl("https://example.com/n.png") }

// The row is written as given, so the user asked for is the user answered.
fake storeUser
    | (newcomer, PasswordHash("$2a$10$fake")) -> newcomer
    | (newcomerInFull, PasswordHash("$2a$10$fake")) -> newcomerInFull
    | (newcomerWithBio, PasswordHash("$2a$10$fake")) -> newcomerWithBio
    | (newcomerWithImage, PasswordHash("$2a$10$fake")) -> newcomerWithImage
    | _ -> jake

example storeUser
    | "the user is inserted and answered as stored" :
        (newcomer, PasswordHash("$2a$10$fake")) -> newcomer
    | "a bio and an image are stored with the user" :
        (newcomerInFull, PasswordHash("$2a$10$fake")) -> newcomerInFull
    | "a bio without an image is stored as that" :
        (newcomerWithBio, PasswordHash("$2a$10$fake")) -> newcomerWithBio
    | "an image without a bio is stored as that" :
        (newcomerWithImage, PasswordHash("$2a$10$fake")) -> newcomerWithImage

example registerUser
    | "a free email and a free username are registered" :
        (Registration { username = Username("newcomer"), email = Email("newcomer@example.com")
                      , password = Password("jakejake") })
        -> newcomer
    | "an email already in use is refused, and nothing is written" :
        (Registration { username = Username("newcomer"), email = Email("gerome@jake.jake")
                      , password = Password("jakejake") })
        -> EmailTaken
    | "a username already in use is refused, and nothing is written" :
        (Registration { username = Username("gerome"), email = Email("free@example.com")
                      , password = Password("jakejake") })
        -> UsernameTaken

// === updating the current user ===
// The boundary works out which fields the request actually changed and hands over the user it wants
// stored; what the domain decides is whether the two names it may have moved are free. The check is
// skipped when a name did not move, so re-saving a profile unchanged is no lookup at all — and an
// address only this user holds is not reported as taken against itself.
behavior storeUserUpdate : (previous: Username, user: User) -> User

behavior updateUser : (current: User, wanted: User) -> User | EmailTaken | UsernameTaken
    depends on findUserByEmail, findUserByName, storeUserUpdate

let updateUser (current, wanted, findUserByEmail, findUserByName, storeUserUpdate) = {
    let emailFree =
        if wanted.email == current.email
        then true
        else match findUserByEmail(wanted.email) with
                 | User         -> false
                 | UserNotFound -> true
    guard emailFree else EmailTaken

    let usernameFree =
        if wanted.username == current.username
        then true
        else match findUserByName(wanted.username) with
                 | User         -> false
                 | UserNotFound -> true
    guard usernameFree else UsernameTaken

    storeUserUpdate(current.username, wanted)
}

// A password is a credential rather than part of a User, so changing one writes nowhere near this
// behavior. It has one rule — Password's invariant — and the decoder is what enforces it, so there
// is nothing left for a composed behavior to decide and the boundary calls this write directly.
behavior storePassword : (username: Username, hash: PasswordHash) -> PasswordHash

// The column holds whatever string it is given, so what is answered is what was written, down to the
// shortest hash the invariant admits.
example storePassword
    | "the hash is written and answered as stored" :
        (Username("jake"), PasswordHash("$2y$10$.oAGfwD2DpocAFWxu6lCU.5U0vvOkE9bbf9IbCstwzWgQhEhUY72a"))
        -> PasswordHash("$2y$10$.oAGfwD2DpocAFWxu6lCU.5U0vvOkE9bbf9IbCstwzWgQhEhUY72a")
    | "the shortest hash the invariant admits is stored all the same" :
        (Username("jake"), PasswordHash("x")) -> PasswordHash("x")

let jakeInFull = User
    { ...jake, bio = Bio("Trains dragons"), image = ImageUrl("https://example.com/jake.png") }
let jakeAtANewAddress = User { ...jake, email = Email("jake@new.example") }
let jacob = User { ...jake, username = Username("jacob") }
let jakeWithBio   = User { ...jake, bio = Bio("Trains dragons") }
let jakeWithImage = User { ...jake, image = ImageUrl("https://example.com/jake.png") }

// What is stored is the user that was asked for, so the table answers each of the users these rows
// ask for with itself, and everything else with jake.
fake storeUserUpdate
    | (Username("jake"), jakeInFull)        -> jakeInFull
    | (Username("jake"), jakeAtANewAddress) -> jakeAtANewAddress
    | (Username("jake"), jacob)             -> jacob
    | (Username("jake"), jake)              -> jake
    | (Username("jake"), jakeWithBio)       -> jakeWithBio
    | (Username("jake"), jakeWithImage)     -> jakeWithImage
    | _                                     -> jake

example storeUserUpdate
    | "the row of the previous name is rewritten and the user asked for is answered" :
        (Username("jake"), jakeAtANewAddress) -> jakeAtANewAddress
    | "a new name moves the row, which is still found by the previous one" :
        (Username("jake"), jacob) -> jacob
    | "a bio and an image are written with the rest" :
        (Username("jake"), jakeInFull) -> jakeInFull
    | "a bio without an image is written as that" :
        (Username("jake"), jakeWithBio) -> jakeWithBio
    | "an image without a bio is written as that" :
        (Username("jake"), jakeWithImage) -> jakeWithImage
    | "a bio and an image dropped are written as absent" :
        (Username("jake"), jake) -> jake

example updateUser
    | "a user who moved neither name is written back with no lookup at all" :
        (jake, jake) -> jake
    | "moving to an address somebody else holds is refused" :
        (jake, User { username = Username("jake"), bio = None, image = None
                    , email = Email("gerome@jake.jake") })
        -> EmailTaken
    | "moving to a username somebody else holds is refused" :
        (jake, User { username = Username("gerome"), bio = None, image = None
                    , email = Email("jake@jake.jake") })
        -> UsernameTaken
    | "a bio and an image may be added, and the user asked for is what is stored" :
        (jake, jakeInFull) -> jakeInFull
    | "a bio and an image may be dropped, and the user asked for is what is stored" :
        (jakeInFull, jake) -> jake
    | "moving to an address nobody holds is stored" :
        (jake, jakeAtANewAddress) -> jakeAtANewAddress
    | "moving to a username nobody holds is stored" :
        (jake, jacob) -> jacob

// === logging in ===
// What a login reads is one row: the user and the hash to check the password against. They are read
// together because they are read for one purpose, and Credentialed is where the hash is allowed to
// live — it never leaves this behavior.
data Credentials  = { email: Email, password: Password }
data Credentialed = { user: User, hash: PasswordHash }

behavior findLogin : (email: Email) -> Credentialed | UserNotFound

behavior verifyPassword : (password: Password, hash: PasswordHash) -> Bool

// A failed login answers InvalidCredentials whichever half was wrong. An unknown email and a wrong
// password are deliberately the same case: an answer that distinguished them would tell a stranger
// which addresses have accounts.
behavior loginUser : (credentials: Credentials) -> User | InvalidCredentials
    depends on findLogin, verifyPassword

let loginUser (credentials, findLogin, verifyPassword) =
    match findLogin(credentials.email) with
        | UserNotFound -> InvalidCredentials
        | Credentialed as found ->
            if verifyPassword(credentials.password, found.hash)
            then found.user
            else InvalidCredentials

// The hashes the users table holds, made by bcrypt for the passwords `jakejake` and `geromepw1`. A
// bcrypt hash can be checked deterministically but not made so, hence the rows fix the strings and
// say what they verify.
let jakeHash   = PasswordHash("$2y$10$.oAGfwD2DpocAFWxu6lCU.5U0vvOkE9bbf9IbCstwzWgQhEhUY72a")
let geromeHash = PasswordHash("$2y$10$GHvKxs4s7OnR483c/3MUPOY7tgcTcmAK7cy1ohywDZAElSNseGxQW")

fake findLogin
    | (Email("jake@jake.jake")) -> Credentialed { user = jake, hash = jakeHash }
    | (Email("gerome@jake.jake")) -> Credentialed { user = gerome, hash = geromeHash }
    | _ -> UserNotFound

example findLogin
    | "the user and the hash stored beside it are read as one row" :
        (Email("jake@jake.jake")) -> Credentialed { user = jake, hash = jakeHash }
    | "a user's bio and image come back with the row" :
        (Email("gerome@jake.jake")) -> Credentialed { user = gerome, hash = geromeHash }
    | "an address nobody holds is not found" : (Email("nobody@example.com")) -> UserNotFound

// bcrypt answers false for a hash it cannot read, as it does for a wrong password, rather than failing.
fake verifyPassword
    | (Password("jakejake"), jakeHash) -> true
    | (Password("geromepw1"), geromeHash) -> true
    | _ -> false

example verifyPassword
    | "the password the hash was made from matches it" : (Password("jakejake"), jakeHash) -> true
    | "another user's password matches the other hash" : (Password("geromepw1"), geromeHash) -> true
    | "a wrong password does not match" : (Password("wrongpass"), jakeHash) -> false
    | "a password does not match the hash of another" : (Password("jakejake"), geromeHash) -> false
    | "a stored value that is no bcrypt hash matches nothing" : (Password("jakejake"), PasswordHash("x")) -> false

example loginUser
    | "the right password logs the user in" :
        (Credentials { email = Email("jake@jake.jake"), password = Password("jakejake") })
        -> jake
    | "a wrong password is invalid credentials" :
        (Credentials { email = Email("jake@jake.jake"), password = Password("wrongpass") })
        -> InvalidCredentials
    | "an unknown email answers that same case, and says nothing more" :
        (Credentials { email = Email("nobody@example.com"), password = Password("jakejake") })
        -> InvalidCredentials

// === following ===
// Only one of the two directions has a rule, and the shapes say so. Following yourself is refused, so
// follow is composed and CannotFollowSelf is one of its cases; unfollowing has no rule to state, so
// there is no behavior wrapping storeUnfollow and the boundary calls it directly. A composed behavior
// that only forwarded its argument would state nothing.
data Followees = { usernames: Set<Username> }

behavior readFollowees : (viewer: Username) -> Followees
behavior storeFollow   : (follower: Username, followee: Username) -> Followees
behavior storeUnfollow : (follower: Username, followee: Username) -> Followees

behavior follow : (follower: Username, followee: Username) -> Followees | CannotFollowSelf
    depends on storeFollow

let follow (follower, followee, storeFollow) =
    if follower == followee
    then CannotFollowSelf
    else storeFollow(follower, followee)

// The follows table the rows below are asked in holds one row: jake follows gerome.
fake storeFollow
    | (Username("jake"), Username("gerome")) -> Followees { usernames = [ Username("gerome") ] }
    | (Username("gerome"), Username("jake")) -> Followees { usernames = [ Username("jake") ] }
    | (Username("jake"), Username("newcomer")) -> Followees { usernames = [ Username("gerome"), Username("newcomer") ] }
    | _ -> Followees { usernames = [] }

example readFollowees
    | "everybody the viewer follows is read at once" :
        (Username("jake")) -> Followees { usernames = [ Username("gerome") ] }
    | "a viewer who follows nobody reads an empty set" :
        (Username("gerome")) -> Followees { usernames = [] }

example storeFollow
    | "following somebody new adds a row beside the old" :
        (Username("jake"), Username("newcomer"))
        -> Followees { usernames = [ Username("gerome"), Username("newcomer") ] }
    | "following somebody already followed is following once" :
        (Username("jake"), Username("gerome")) -> Followees { usernames = [ Username("gerome") ] }
    | "the first follow of a viewer makes the set of one" :
        (Username("gerome"), Username("jake")) -> Followees { usernames = [ Username("jake") ] }

example storeUnfollow
    | "unfollowing removes the row and answers what is left" :
        (Username("jake"), Username("gerome")) -> Followees { usernames = [] }
    | "unfollowing somebody never followed removes nothing and is no error" :
        (Username("jake"), Username("newcomer")) -> Followees { usernames = [ Username("gerome") ] }
    | "a viewer with no follows unfollows into the empty set" :
        (Username("gerome"), Username("jake")) -> Followees { usernames = [] }

example follow
    | "following somebody else adds them to the set" :
        (Username("jake"), Username("gerome"))
        -> Followees { usernames = [ Username("gerome") ] }
    | "following yourself is refused, and nothing is written" :
        (Username("jake"), Username("jake"))
        -> CannotFollowSelf
    | "the shortest name cannot follow itself either" :
        (Username("a"), Username("a")) -> CannotFollowSelf
    | "nor can the longest" :
        (Username(String.repeat(40, "a")), Username(String.repeat(40, "a"))) -> CannotFollowSelf
