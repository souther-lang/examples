// Comments on an article.
//
// Only one rule lives here, and it is the same one articles state about editing: a comment is its
// author's to delete. Writing one has no rule — anybody who is logged in may comment — so there is no
// composed behavior wrapping the write, and the boundary calls storeComment directly. A behavior that
// only forwarded its argument would state nothing, and the shape of this module is what says which of
// the two operations carries a decision.
//
// This is the third module in the chain: comments imports articles for the Slug a comment hangs on,
// and identity for the Profile that wrote it. articles imports identity too, so the two paths to
// Profile meet — and agree, because a module is resolved once per compile.
module blog.comments exposing (
    CommentId,
    CommentBody,
    Comment,
    CommentThread,
    CommentNotFound,
    Removed,
    NotTheAuthor,
    storeComment,
    readComments,
    findComment,
    removeComment,
    deleteComment
)
import blog.identity ( Profile, Username )
import blog.articles ( Slug )

// The id is the store's to hand out, so the invariant says only that one exists.
data CommentId = Int
    invariant value >= 1

data CommentBody = String
    invariant String.length(value) >= 1

data Comment =
    { id: CommentId
    , body: CommentBody
    , author: Profile
    , createdAt: DateTime
    , updatedAt: DateTime
    }

data CommentThread = { comments: List<Comment> }

// === the injected writes and reads ===
behavior storeComment  : (slug: Slug, body: CommentBody, author: Profile, at: DateTime) -> Comment
behavior readComments  : (slug: Slug) -> CommentThread
behavior removeComment : (comment: Comment) -> Removed

behavior findComment : (id: CommentId) -> Comment | CommentNotFound

// === the one rule ===
behavior deleteComment : (comment: Comment, deleter: Username) -> Removed | NotTheAuthor
    depends on removeComment

let deleteComment (comment, deleter, removeComment) = {
    guard deleter == comment.author.username else NotTheAuthor
    removeComment(comment)
}

let jake = Profile { username = Username("jake"), bio = None, image = None }

// A comment whose author has said everything a profile can. Its id is 2 because 1 is the lowest id
// there is, and its body is the shortest one the invariant admits.
let jakeInFull = Profile
    { username = Username("jake")
    , bio = blog.identity.Bio("Trains dragons")
    , image = blog.identity.ImageUrl("https://example.com/jake.png")
    }

let aSecondThought = Comment
    { id = CommentId(2)
    , body = CommentBody("x")
    , author = jakeInFull
    , createdAt = DateTime("2026-08-06T03:22:56")
    , updatedAt = DateTime("2026-08-06T03:22:56")
    }

let hisNameWasMyNameToo = Comment
    { id = CommentId(1)
    , body = CommentBody("His name was my name too.")
    , author = jake
    , createdAt = DateTime("2026-08-06T03:22:56")
    , updatedAt = DateTime("2026-08-06T03:22:56")
    }

fake removeComment
    | _ -> Removed

example deleteComment
    | "the author may delete their own comment" :
        (hisNameWasMyNameToo, Username("jake")) -> Removed
    | "somebody who did not write it may not" :
        (hisNameWasMyNameToo, Username("gerome")) -> NotTheAuthor
    | "an author with a bio and an image may delete a one-character comment" :
        (aSecondThought, Username("jake")) -> Removed

// === the contract with the comments table ===
// The world these rows are asked in has two comments on how-to-train-your-dragon: id 1 by jake, who
// has said nothing about himself, and id 2 by gerome, who has said everything. The next id the table
// hands out is 3. The store answers the profile it was given and does not read it back, so the rows
// for writing vary the profile and the rows for reading vary who wrote the comment.
let geromeInFull = Profile
    { username = Username("gerome")
    , bio = blog.identity.Bio("Writes monads")
    , image = blog.identity.ImageUrl("https://example.com/gerome.png")
    }

let anotherThought = Comment
    { id = CommentId(2)
    , body = CommentBody("A monad is a burrito")
    , author = geromeInFull
    , createdAt = DateTime("2026-08-06T04:00:00")
    , updatedAt = DateTime("2026-08-06T04:00:00")
    }

let dragon = Slug("how-to-train-your-dragon")
let later  = DateTime("2026-08-06T05:00:00")
let thirdThought = Comment
    { id = CommentId(3), body = CommentBody("Me too"), author = jake, createdAt = later, updatedAt = later }

example storeComment
    | "the row is inserted with the next id, and both its times are when it was written" :
        (dragon, CommentBody("Me too"), jake, later) -> thirdThought
    | "an author's bio and image are answered with the comment" :
        (dragon, CommentBody("Me too"), geromeInFull, later) -> Comment { ...thirdThought, author = geromeInFull }
    | "a bio without an image is answered as that" :
        (dragon, CommentBody("Me too"), Profile { ...jake, bio = blog.identity.Bio("Trains dragons") }, later)
        -> Comment { ...thirdThought, author = Profile { ...jake, bio = blog.identity.Bio("Trains dragons") } }
    | "an image without a bio is answered as that" :
        (dragon, CommentBody("Me too"), Profile { ...jake, image = blog.identity.ImageUrl("https://example.com/jake.png") }, later)
        -> Comment { ...thirdThought
                   , author = Profile { ...jake, image = blog.identity.ImageUrl("https://example.com/jake.png") } }

example readComments
    | "the thread is every comment on the article, oldest first, each with its author's profile" :
        (dragon) -> CommentThread { comments = [ hisNameWasMyNameToo, anotherThought ] }
    | "an article nobody commented on has an empty thread" :
        (Slug("dragons-are-real")) -> CommentThread { comments = [] }

example findComment
    | "an id the table holds finds its comment" : (CommentId(1)) -> hisNameWasMyNameToo
    | "the author's bio and image come back with the comment" : (CommentId(2)) -> anotherThought
    | "an id the table does not hold is not found" : (CommentId(99)) -> CommentNotFound

example removeComment
    | "the row goes" : (hisNameWasMyNameToo) -> Removed
    | "an author's bio and image do not change that" : (anotherThought) -> Removed
    | "a bio without an image removes it all the same" :
        (Comment { ...thirdThought, author = Profile { ...jake, bio = blog.identity.Bio("Trains dragons") } })
        -> Removed
    | "an image without a bio removes it all the same" :
        (Comment { ...thirdThought
                 , author = Profile { ...jake, image = blog.identity.ImageUrl("https://example.com/jake.png") } })
        -> Removed
    | "a comment that is already gone is removed all the same, and is no error" : (thirdThought) -> Removed
