// 出張申請。仕様DSL で書いた型・状態・behavior と、そこに費目や費用負担区分を足して精製した
// ものを、そのまま Souther で書き直した。ドメインは data＋invariant＋behavior だけで、
// decoder/encoder は導出される。カスタムのキー名・正規化・判別子が要るなら、それは境界
// （Java/Raoh）の仕事。
//
// 見どころ:
//   - 申請の状態そのものが直和。申請準備中 から 承認完了 までの9状態を `data 出張申請` に並べ、
//     状態ごとに持つ項目が違う（提出済みは提出日時を持ち、承認完了は精算額を持つ）。behavior の
//     入力は状態の型なので、まだ提出していない申請を承認する呼び出しは書けない。
//   - 直和が直和を抱える: 費用負担区分 -> 自社負担 -> 立替。match は段ごとに開くので、精算対象が
//     「自社負担の立替だけ」というルールがこの二段の match にそのまま出る。一方 JSON は葉の名前
//     そのもの（`"負担": "立替"`）で、境界の形は入れ子で深くならない。全ケースが単位データなので
//     タグを載せたオブジェクトにもならない。
//   - 費目（交通費/宿泊費/交際費/その他費用）はどれも金額を持つ。全ケースが 費目共通 を spread
//     しているので、直和のまま 費目.金額 と読めて、合計に match は要らない。
//   - 明細のリストには 予定費用 / 実費用 という名前がある。newtype がコレクションを包めるので、
//     「空ではない」をそのリストについての invariant に書けて、境界では裸の JSON 配列になる。
//     読むときは `.value` ではなく `予定費用(明細)` と引数の位置で開く。
//   - 事前条件はエラーケースに落とし、invariant は abort させる。却下理由が空という「業務上
//     起こりうること」は 却下理由なし ケースで返し、guard を通った後に 却下理由 を構築する
//     ので、newtype の invariant はその guard で解消される。
//   - 項目を持たない data は、直和のケース欄と behavior の出力に名前を書けば、それが宣言になる。
//     一般社員・立替・先方負担・承認権限なし に `data` の行はない。仕様DSL が
//     `-> 事前承認済み OR 承認権限なし` としか書かないところに、宣言を足さなくてよい。
//   - 時計は外の世界なので、提出日時・承認日時・却下日時・完了日時は引数で受け取る。
module example.businesstrip

// === 基本的な値 ===

data 金額 = Int
    invariant value >= 0

data 従業員ID = String
    invariant String.length(value) >= 1

// === 役職 ===
// 仕様DSLの `data 管理職 = レベル // レベル1-5`。範囲は newtype の invariant に置く。

data 決裁レベル = Int
    invariant value >= 1 && value <= 5

data 管理職 = { レベル: 決裁レベル }

data 役職 = 管理職 | 一般社員

// 氏名などの表示用属性は仕様モデルの関心外なので持たない。上長IDを持つので、承認者が本当に
// この申請者の上長かという照合はドメインの中で完結する。
data 従業員 =
    { 従業員ID: 従業員ID
    , 役職: 役職
    , 上長ID: 従業員ID
    }

// === 費目 ===
// 費目ごとに持つ項目が違う（交通費は区間、宿泊費はインボイス番号、交際費は人数）ので直和にする。

data 出発地 = String
    invariant String.length(value) >= 1
data 到着地 = String
    invariant String.length(value) >= 1
data インボイス登録番号 = String
    invariant String.matches("T[0-9]{13}", value)
data 使用人数 = Int
    invariant value >= 1
data 費目名 = String
    invariant String.length(value) >= 1

// 全ケースが同じ data を spread していると、直和のまま 費目.金額 と読める。
data 費目共通 = { 金額: 金額 }

data 交通費 =
    { ...費目共通
    , 出発地: 出発地
    , 到着地: 到着地
    }
data 宿泊費 =
    { ...費目共通
    , インボイス登録番号: インボイス登録番号
    }
data 交際費 =
    { ...費目共通
    , 使用人数: 使用人数
    }
data その他費用 =
    { ...費目共通
    , 費目名: 費目名
    }

data 費目 = 交通費 | 宿泊費 | 交際費 | その他費用

// === 費用負担区分 ===
// 自社負担を払い方で細分化する。仮払いと会社カードは会社資産の使用なので、個人への払い戻しの
// 対象は立替だけになる ── 精算額を計算する がこの区別を使う。
// 自社負担 は直和でありながら 費用負担区分 のケースでもある。導出デコーダは段ごとではなく葉まで
// 見て 立替 / 仮払い / 会社カード / 先方負担 を判別する。全ケースが単位データなので、JSON はその名前
// そのものになる。

data 自社負担 = 立替 | 仮払い | 会社カード
data 費用負担区分 = 自社負担 | 先方負担

// 費目と費用負担区分は直交する。交通費でも宿泊費でも、自社負担も先方負担もあり得る。
data 費用明細 =
    { 費目: 費目
    , 負担: 費用負担区分
    }

// 明細のリスト自体に名前を付ける。「空リストではない」はそのリストについての invariant で、
// 境界での姿は `{"明細": [...]}` ではなくリストの表現そのまま（JSON 配列）。
data 予定費用 = List<費用明細>
    invariant List.length(value) >= 1
data 実費用 = List<費用明細>
    invariant List.length(value) >= 1

// === 出張申請の共通項目 ===

data 出張先 = String
    invariant String.length(value) >= 1
data 出張目的 = String
    invariant String.length(value) >= 1

data 出張申請共通項目 =
    { 申請者: 従業員
    , 予定費用: 予定費用
    , 出張先: 出張先
    , 出張目的: 出張目的
    , 出張開始日: Date
    , 出張終了日: Date
    }
    invariant Date.daysBetween(出張開始日, 出張終了日) >= 0

// === 事前承認が必要となる理由 ===

data 高額出張 = { 基準金額: 金額 }
data 権限不足 = { 役職: 役職 }

data 事前承認理由 = 高額出張 | 権限不足 | 先方費用負担

// 理由が0件なら事前承認は要らないという意味なので、こちらには「空ではない」の invariant を置かない。
data 事前承認理由リスト = List<事前承認理由>

// === 事前承認の有無 ===
// 仕様DSLは 出張完了 以降に `事前承認日時? AND 事前承認者ID?` と optional を2つ並べるが、
// ここでは直和にする。日時だけあって承認者IDがない組み合わせが型で消えるし、Souther の
// Option は非サーフェス（behavior の本体では None を作れない）ので、そもそも optional の対では
// 事前承認を経ていない申請から 出張完了 を構築できない。

data 事前承認あり =
    { 事前承認日時: DateTime
    , 事前承認者ID: 従業員ID
    }

data 事前承認履歴 = 事前承認なし | 事前承認あり

// === 出張申請の状態 ===

data 却下理由 = String
    invariant String.length(value) >= 1
data 出張報告 = String
    invariant String.length(value) >= 1
data 精算額 = Int
    invariant value >= 0

data 申請準備中 = { ...出張申請共通項目 }

// 事前承認不要の場合はここへ来る。
data 提出済み =
    { ...出張申請共通項目
    , 提出日時: DateTime
    }

// 承認者はまだ確定していない。照合は 申請者.上長ID で行うので保存しない。
data 事前承認待ち =
    { ...出張申請共通項目
    , 提出日時: DateTime
    , 事前承認理由リスト: 事前承認理由リスト
    }

data 事前承認却下済み =
    { ...出張申請共通項目
    , 提出日時: DateTime
    , 却下日時: DateTime
    , 却下理由: 却下理由
    , 却下者ID: 従業員ID
    }

data 事前承認済み =
    { ...出張申請共通項目
    , 提出日時: DateTime
    , 事前承認: 事前承認あり
    }

data 出張完了共通項目 =
    { ...出張申請共通項目
    , 実費用: 実費用
    , 提出日時: DateTime
    , 完了日時: DateTime
    , 出張報告: 出張報告
    , 事前承認: 事前承認履歴
    }

data 出張完了 = { ...出張完了共通項目 }

// 最終承認者もまだ確定していない。
data 最終承認待ち = { ...出張完了共通項目 }

data 最終承認却下済み =
    { ...出張完了共通項目
    , 却下日時: DateTime
    , 却下理由: 却下理由
    , 却下者ID: 従業員ID
    }

data 承認完了 =
    { ...出張完了共通項目
    , 最終承認日時: DateTime
    , 最終承認者ID: 従業員ID
    , 精算額: 精算額
    }

data 出張申請 =
    申請準備中
    | 提出済み
    | 事前承認待ち
    | 事前承認却下済み
    | 事前承認済み
    | 出張完了
    | 最終承認待ち
    | 最終承認却下済み
    | 承認完了

// 出張を完了する と 差し戻す は複数の状態から始まる。仕様DSLの `(提出済み OR 事前承認済み)` を
// 受けるために、その2つだけを束ねた直和を置く。同じ data が 出張申請 と 出張中 の両方のケースに
// なる ── ケースは名前付き data への参照なので、いくつの直和から指されてもよい。
data 出張中 = 提出済み | 事前承認済み
data 却下済み = 事前承認却下済み | 最終承認却下済み

// === 費用明細リストの合計を計算する ===
// 費目 を開かずに金額が読める。List.sum は Int と Decimal しか取らないので .value に落とす。

behavior 費用明細リストの合計を計算する : (明細: List<費用明細>) -> 金額
    constructs 金額

let 明細の金額 (明細: 費用明細): 金額 = 明細.費目.金額

let 明細の合計 (明細: List<費用明細>): Int =
    List.sum(List.map(明細 -> 明細の金額(明細).value, 明細))

let 費用明細リストの合計を計算する (明細) = 金額(明細の合計(明細))

example 費用明細リストの合計を計算する
    | "費目が混ざっていても金額を取り出して合算する" :
        ([ 福岡までの交通費, 会社カードの宿泊費, 先方負担の交際費 ])
            -> 金額(60000)

// === 事前承認要否を判定する ===
// 1. 予定費用の合計が10万円以上
// 2. 申請者が一般社員
// 3. 予定費用の明細に1件でも先方負担がある（接待との境界が曖昧になるため）
// 理由が1つも残らなければ事前承認は要らない。

let 先方負担か (負担: 費用負担区分): Bool =
    match 負担 with
        | 自社負担 -> false
        | 先方負担 -> true

// 理由を if で継ぎ足していくのではなく、3つの候補を並べて該当するものだけ残す。理由を増やすと
// 該当するか の match が網羅漏れとしてコンパイル時に落ちるので、「理由を足したのに、どんなとき
// に当たるのかを書き忘れる」が起こらない。ケースの違う値を並べたリストは 事前承認理由 の直和に
// 揃うので、候補はそのまま List<事前承認理由> として書ける。
let 事前承認理由の候補 (申請者: 従業員): List<事前承認理由> =
    [ 高額出張 { 基準金額 = 金額(100000) }
    , 権限不足 { 役職 = 申請者.役職 }
    , 先方費用負担 ]

// 判定規則は理由ごとに名前を持つ。仕様の語彙がそのままここに並ぶ。引数の位置で 予定費用 を開くので、
// 本体には `.value` が出てこないし、`予定費用(明細)` と書けること自体が引数の型の宣言になる。
let 高額か (予定費用(明細), 基準金額: 金額): Bool =
    明細の合計(明細) >= 基準金額.value

let 一般社員か (申請者: 従業員): Bool =
    match 申請者.役職 with
        | 管理職   -> false
        | 一般社員 -> true

let 先方負担を含むか (予定費用(明細)): Bool =
    List.any(明細 -> 先方負担か(明細.負担), 明細)

// 高額出張の基準額は理由そのものが持っているので、閾値の10万円はこのモデルに一度しか現れない。
let 該当するか (予定費用: 予定費用, 申請者: 従業員, 理由: 事前承認理由): Bool =
    match 理由 with
        | 高額出張 { 基準金額 } -> 高額か(予定費用, 基準金額)
        | 権限不足              -> 一般社員か(申請者)
        | 先方費用負担          -> 先方負担を含むか(予定費用)

let 事前承認の理由 (予定費用: 予定費用, 申請者: 従業員): List<事前承認理由> =
    List.filter(理由 -> 該当するか(予定費用, 申請者, 理由), 事前承認理由の候補(申請者))

behavior 事前承認要否を判定する : (予定費用: 予定費用, 申請者: 従業員) -> 事前承認理由リスト
    constructs 事前承認理由リスト, 高額出張, 権限不足, 先方費用負担, 金額

let 事前承認要否を判定する (予定費用, 申請者) =
    事前承認理由リスト(事前承認の理由(予定費用, 申請者))

// === 精算額を計算する ===
// 明細1件ごとに払い戻す額を決めて足す。仮払いと会社カードは会社資産の使用なので個人への払い戻しの
// 対象外、先方負担は会社を経由しない支払いなので対象外。match は段ごとに開くので、精算対象が
// 自社負担の立替だけであることが二段の match にそのまま出る。`as` で外側のケースを束ねて開く。

let 精算する額 (明細: 費用明細): Int =
    match 明細.負担 with
        | 自社負担 as 自社 ->
            match 自社 with
                | 立替       -> 明細.費目.金額.value
                | 仮払い     -> 0
                | 会社カード -> 0
        | 先方負担 -> 0

let 精算する額の合計 (実費用(明細)): Int =
    List.sum(List.map(精算する額, 明細))

behavior 精算額を計算する : (実費用: 実費用) -> 精算額
    constructs 精算額

let 精算額を計算する (実費用) = 精算額(精算する額の合計(実費用))

example 精算額を計算する
    | "払い戻すのは立替だけ" :
        (実費用([ 福岡までの交通費, 会社カードの宿泊費, 先方負担の交際費 ]))
            -> 精算額(28000)
    | "会社カードと先方負担しかなければ0円" :
        (実費用([ 会社カードの宿泊費, 先方負担の交際費 ]))
            -> 精算額(0)

// === example が語る申請 ===
// 行がフィクスチャを名前で呼ぶ。この節の申請は二人ぶん ── 決裁レベル3の管理職と一般社員 ── と、
// 明細が三つ。状態は前の状態にその段で決まったものが重なるので、フィクスチャも spread で重ねる。
// 変えるのは行ごとに一項目だけになる。

// data 管理職 と同じ名前は使えない（値を書く位置では1つの名前）。
let 管理職の申請者 = 従業員 { 従業員ID = 従業員ID("e-001"), 役職 = 管理職 { レベル = 決裁レベル(3) }
                           , 上長ID = 従業員ID("m-001") }

let 一般社員の申請者 = 従業員 { 従業員ID = 従業員ID("e-002"), 役職 = 一般社員
                             , 上長ID = 従業員ID("m-001") }

let 福岡までの交通費 = 費用明細
    { 費目 = 交通費 { 金額 = 金額(28000), 出発地 = 出発地("東京"), 到着地 = 到着地("福岡") }
    , 負担 = 立替 }

let 横浜までの交通費 = 費用明細
    { 費目 = 交通費 { 金額 = 金額(3000), 出発地 = 出発地("東京"), 到着地 = 到着地("横浜") }
    , 負担 = 立替 }

let 会社カードの宿泊費 = 費用明細
    { 費目 = 宿泊費 { 金額 = 金額(12000), インボイス登録番号 = インボイス登録番号("T1234567890123") }
    , 負担 = 会社カード }

let 先方負担の交際費 = 費用明細
    { 費目 = 交際費 { 金額 = 金額(20000), 使用人数 = 使用人数(4) }
    , 負担 = 先方負担 }

// 管理職の福岡出張。少額・自社負担なので、そのまま出せば事前承認は要らない。
let 福岡出張の申請 = 申請準備中
    { 申請者 = 管理職の申請者
    , 予定費用 = 予定費用([ 福岡までの交通費 ])
    , 出張先 = 出張先("福岡")
    , 出張目的 = 出張目的("顧客訪問")
    , 出張開始日 = Date("2026-08-03")
    , 出張終了日 = Date("2026-08-05")
    }

// 一般社員の横浜出張。金額に関わらず事前承認待ちになる側。
let 横浜出張の申請 = 申請準備中
    { 申請者 = 一般社員の申請者
    , 予定費用 = 予定費用([ 横浜までの交通費 ])
    , 出張先 = 出張先("横浜")
    , 出張目的 = 出張目的("打合せ")
    , 出張開始日 = Date("2026-08-03")
    , 出張終了日 = Date("2026-08-03")
    }

let 提出された福岡出張 = 提出済み
    { ...福岡出張の申請, 提出日時 = DateTime("2026-07-27T09:00:00") }

let 事前承認を待つ横浜出張 = 事前承認待ち
    { ...横浜出張の申請
    , 提出日時 = DateTime("2026-07-27T09:00:00")
    , 事前承認理由リスト = 事前承認理由リスト([ 権限不足 { 役職 = 一般社員 } ])
    }

let 実費の福岡までの交通費 = 費用明細
    { 費目 = 交通費 { 金額 = 金額(31000), 出発地 = 出発地("東京"), 到着地 = 到着地("福岡") }
    , 負担 = 立替 }

// 出張から戻ったあとの状態。項目がいちばん多く、付属ファイルの行はここから spread する。
let 最終承認を待つ福岡出張 = 最終承認待ち
    { ...提出された福岡出張
    , 実費用 = 実費用([ 実費の福岡までの交通費, 会社カードの宿泊費 ])
    , 完了日時 = DateTime("2026-08-05T18:00:00")
    , 出張報告 = 出張報告("訪問して受注")
    , 事前承認 = 事前承認あり { 事前承認日時 = DateTime("2026-07-27T10:00:00")
                            , 事前承認者ID = 従業員ID("m-001") }
    }

// === 出張申請を提出する ===
// 事前承認理由が空なら 提出済み、空でないなら 事前承認待ち。

behavior 出張申請を提出する : (申請: 申請準備中, 提出日時: DateTime) -> 提出済み | 事前承認待ち
    constructs 提出済み, 事前承認待ち, 事前承認理由リスト, 高額出張, 権限不足, 先方費用負担, 金額

let 出張申請を提出する (申請, 提出日時) = {
    let 理由 = 事前承認の理由(申請.予定費用, 申請.申請者)
    if List.isEmpty(理由)
        then 提出済み { ...申請, 提出日時 = 提出日時 }
        else 事前承認待ち { ...申請, 提出日時 = 提出日時, 事前承認理由リスト = 事前承認理由リスト(理由) }
}

// === 事前承認する / 事前承認を却下する ===
// 事前条件は「承認者IDが申請者の上長IDと一致すること」。一致しなければ 承認権限なし で返る ──
// 例外ではなくケースなので、呼び出し側は match で受ける。

behavior 事前承認する : (申請: 事前承認待ち, 承認者ID: 従業員ID, 事前承認日時: DateTime)
    -> 事前承認済み | 承認権限なし
    constructs 事前承認済み, 事前承認あり, 承認権限なし

let 事前承認する (申請, 承認者ID, 事前承認日時) = {
    guard 承認者ID == 申請.申請者.上長ID else 承認権限なし
    事前承認済み { ...申請
        , 事前承認 = 事前承認あり { 事前承認日時 = 事前承認日時, 事前承認者ID = 承認者ID } }
}

// 却下理由は裸の String で受けて、構築を試みる。空文字列は業務上起こりうることなので
// 却下理由なし ケースで返す ── 何が空かを決めるのは 却下理由 の invariant で、ここには
// その名前と離脱するケースしか書かない。
behavior 事前承認を却下する : (申請: 事前承認待ち, 承認者ID: 従業員ID, 理由: String, 却下日時: DateTime)
    -> 事前承認却下済み | 承認権限なし | 却下理由なし
    constructs 事前承認却下済み, 却下理由, 承認権限なし, 却下理由なし

let 事前承認を却下する (申請, 承認者ID, 理由, 却下日時) = {
    guard 承認者ID == 申請.申請者.上長ID else 承認権限なし
    guard 却下理由(理由) as 却下の理由 else 却下理由なし

    事前承認却下済み { ...申請
        , 却下日時 = 却下日時
        , 却下理由 = 却下の理由
        , 却下者ID = 承認者ID }
}

// === 出張を完了する ===
// 提出済み（事前承認を経なかった）と 事前承認済み のどちらからも完了できる。違いは
// 事前承認履歴 に出る ── 前者は 事前承認なし、後者は経てきた 事前承認あり をそのまま持ち越す。
// 明細も報告も裸で受けて、構築を試みる。「空ではない」は 実費用 と 出張報告 の invariant が答える。
// 残る guard は合計が正であること ── これは 実費用 の invariant ではなく、ここだけの業務規則。

behavior 出張を完了する : (申請: 出張中, 明細: List<費用明細>, 報告: String, 完了日時: DateTime)
    -> 出張完了 | 不正な実費用 | 出張報告なし
    constructs 出張完了, 実費用, 出張報告, 事前承認なし, 不正な実費用, 出張報告なし

let 出張を完了する (申請, 明細, 報告, 完了日時) = {
    guard 実費用(明細) as 実費 else 不正な実費用
    guard 明細の合計(明細) > 0 else 不正な実費用
    guard 出張報告(報告) as 報告文 else 出張報告なし

    match 申請 with
        | 提出済み as 提出 ->
            出張完了 { ...提出
                , 実費用 = 実費
                , 完了日時 = 完了日時
                , 出張報告 = 報告文
                , 事前承認 = 事前承認なし }
        | 事前承認済み as 承認済 ->
            出張完了 { ...承認済
                , 実費用 = 実費
                , 完了日時 = 完了日時
                , 出張報告 = 報告文
                , 事前承認 = 承認済.事前承認 }
}

// === 最終承認を依頼する ===
// 項目は変わらず、状態だけが進む。

behavior 最終承認を依頼する : (完了: 出張完了) -> 最終承認待ち
    constructs 最終承認待ち

let 最終承認を依頼する (完了) = 最終承認待ち { ...完了 }

// === 最終承認する / 最終承認を却下する ===
// 承認完了 は精算額を必須フィールドとして持つので、承認と同時に計算する。

behavior 最終承認する : (申請: 最終承認待ち, 承認者ID: 従業員ID, 最終承認日時: DateTime)
    -> 承認完了 | 承認権限なし
    constructs 承認完了, 精算額, 承認権限なし

let 最終承認する (申請, 承認者ID, 最終承認日時) = {
    guard 承認者ID == 申請.申請者.上長ID else 承認権限なし
    承認完了 { ...申請
        , 最終承認日時 = 最終承認日時
        , 最終承認者ID = 承認者ID
        , 精算額 = 精算額(精算する額の合計(申請.実費用)) }
}

behavior 最終承認を却下する : (申請: 最終承認待ち, 承認者ID: 従業員ID, 理由: String, 却下日時: DateTime)
    -> 最終承認却下済み | 承認権限なし | 却下理由なし
    constructs 最終承認却下済み, 却下理由, 承認権限なし, 却下理由なし

let 最終承認を却下する (申請, 承認者ID, 理由, 却下日時) = {
    guard 承認者ID == 申請.申請者.上長ID else 承認権限なし
    guard 却下理由(理由) as 却下の理由 else 却下理由なし

    最終承認却下済み { ...申請
        , 却下日時 = 却下日時
        , 却下理由 = 却下の理由
        , 却下者ID = 承認者ID }
}

// === 差し戻す ===
// 却下を受けてシステムが 申請準備中 へ戻す。人間のアクターを持たないので引数は状態だけ。
// 却下理由は持ち越さない ── 戻った後、申請者が内容を直して再提出する。なぜ却下されたかの履歴は
// イベント系列の関心事として扱う。

behavior 差し戻す : (却下: 却下済み) -> 申請準備中
    constructs 申請準備中

let 差し戻す (却下) = 申請準備中 { ...却下 }

// === 提出から承認までを固定する例 ===
// 閾値の両側と、承認者の照合、却下理由の空文字を example で押さえる。

example 出張申請を提出する
    | "管理職の少額・自社負担なら事前承認は要らない" :
        (福岡出張の申請, DateTime("2026-07-27T09:00:00"))
            -> 提出済み
    | "10万円を超えれば事前承認待ちになる" :
        (申請準備中 { ...福岡出張の申請
                    , 予定費用 = 予定費用(
                        [ 費用明細 { 費目 = 交通費 { 金額 = 金額(100000), 出発地 = 出発地("東京")
                                                 , 到着地 = 到着地("シンガポール") }
                                   , 負担 = 立替 } ])
                    , 出張先 = 出張先("シンガポール") }, DateTime("2026-07-27T09:00:00"))
            -> 事前承認待ち
    | "一般社員は金額に関わらず事前承認待ちになる" :
        (横浜出張の申請, DateTime("2026-07-27T09:00:00"))
            -> 事前承認待ち
    | "先方負担が1件でも混ざれば事前承認待ちになる" :
        (申請準備中 { ...福岡出張の申請
                    , 予定費用 = 予定費用([ 横浜までの交通費, 先方負担の交際費 ]) },
         DateTime("2026-07-27T09:00:00"))
            -> 事前承認待ち

example 事前承認する
    | "上長なら承認できる" :
        (事前承認を待つ横浜出張,
         従業員ID("m-001"), DateTime("2026-07-27T10:00:00"))
            -> 事前承認済み
    | "上長でなければ承認権限なし" :
        (事前承認を待つ横浜出張,
         従業員ID("m-999"), DateTime("2026-07-27T10:00:00"))
            -> 承認権限なし

example 事前承認を却下する
    | "却下理由が空なら却下理由なし" :
        (事前承認を待つ横浜出張,
         従業員ID("m-001"), "", DateTime("2026-07-27T10:00:00"))
            -> 却下理由なし

example 出張を完了する
    | "実費用が空なら不正な実費用" :
        (提出された福岡出張,
         [], "訪問して受注", DateTime("2026-08-05T18:00:00"))
            -> 不正な実費用
    | "出張報告が空なら出張報告なし" :
        (提出された福岡出張,
         [ 実費の福岡までの交通費 ], "", DateTime("2026-08-05T18:00:00"))
            -> 出張報告なし
    | "事前承認を経ていなければ事前承認なしで完了する" :
        (提出された福岡出張,
         [ 実費の福岡までの交通費 ], "訪問して受注", DateTime("2026-08-05T18:00:00"))
            -> 出張完了
