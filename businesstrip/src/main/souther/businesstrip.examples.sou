                出張終了日 = Date("2000-01-01"),
                提出日時 = DateTime("2000-01-01T00:00:00"),
                事前承認理由リスト = 事前承認理由リスト([高額出張 { 基準金額 = 金額(0) }])
            },
            従業員ID("x"),
            DateTime("2000-01-01T00:00:00")
        )
        -> 事前承認済み
    | "申請.予定費用[*].負担=先方負担"
        : (
            事前承認待ち {
                申請者 = 従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") },
                予定費用 = 予定費用(
                    [
                        費用明細 {
                            費目 = 交通費 {
                                金額 = 金額(0),
                                出発地 = 出発地("x"),
                                到着地 = 到着地("x")
                            },
                            負担 = 先方負担
