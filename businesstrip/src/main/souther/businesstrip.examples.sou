    )
        -> 提出済み
    | (
        申請準備中 {
            申請者 = 従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") },
            予定費用 = 予定費用(
                [
                    費用明細 {
                        費目 = 交通費 {
                            金額 = 金額(100001),
                            出発地 = 出発地("x"),
                            到着地 = 到着地("x")
                        },
                        負担 = 立替
                    }
                ]
            ),
            出張先 = 出張先("x"),
            出張目的 = 出張目的("x"),
            出張開始日 = Date("2000-01-01"),
