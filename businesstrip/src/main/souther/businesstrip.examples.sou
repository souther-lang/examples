example 出張申請を提出する
// fills 申請.予定費用[*].負担=立替
// fills 申請.予定費用[*].費目=交通費
// fills 申請.申請者.役職=管理職
    | (福岡出張の申請, DateTime("2000-01-01T00:00:00"))                               -> 提出済み
    | "申請.予定費用[*].負担=仮払い"
        : (
            申請準備中 {
                申請者 = 従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") },
                予定費用 = 予定費用(
                    [
                        費用明細 {
                            費目 = 交通費 {
                                金額 = 金額(0),
                                出発地 = 出発地("x"),
                                到着地 = 到着地("x")
                            },
                            負担 = 仮払い
                        }
                    ]
                ),
                出張先 = 出張先("x"),
                出張目的 = 出張目的("x"),
                出張開始日 = Date("2000-01-01"),
                出張終了日 = Date("2000-01-01")
            },
            DateTime("2000-01-01T00:00:00")
        )
        -> 提出済み
    | "申請.予定費用[*].負担=先方負担"
        : (
            申請準備中 {
                申請者 = 従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") },
                予定費用 = 予定費用(
                    [
                        費用明細 {
                            費目 = 交通費 {
                                金額 = 金額(0),
                                出発地 = 出発地("x"),
                                到着地 = 到着地("x")
                            },
                            負担 = 先方負担
                        }
                    ]
                ),
                出張先 = 出張先("x"),
                出張目的 = 出張目的("x"),
                出張開始日 = Date("2000-01-01"),
                出張終了日 = Date("2000-01-01")
            },
            DateTime("2000-01-01T00:00:00")
        )
        -> 事前承認待ち
    | "申請.予定費用[*].費目=交際費"
        : (
            申請準備中 {
                申請者 = 従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") },
                予定費用 = 予定費用(
                    [
                        費用明細 {
                            費目 = 交際費 { 金額 = 金額(0), 使用人数 = 使用人数(1) },
                            負担 = 立替
                        }
                    ]
                ),
                出張先 = 出張先("x"),
                出張目的 = 出張目的("x"),
                出張開始日 = Date("2000-01-01"),
                出張終了日 = Date("2000-01-01")
            },
            DateTime("2000-01-01T00:00:00")
        )
        -> 提出済み
    | "申請.予定費用[*].費目=その他費用"
        : (
            申請準備中 {
                申請者 = 従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") },
                予定費用 = 予定費用(
                    [
                        費用明細 {
                            費目 = その他費用 { 金額 = 金額(0), 費目名 = 費目名("x") },
                            負担 = 立替
                        }
                    ]
                ),
                出張先 = 出張先("x"),
                出張目的 = 出張目的("x"),
                出張開始日 = Date("2000-01-01"),
                出張終了日 = Date("2000-01-01")
            },
            DateTime("2000-01-01T00:00:00")
        )
        -> 提出済み
    | "申請.申請者.役職=一般社員" : (横浜出張の申請, DateTime("2000-01-01T00:00:00")) -> 事前承認待ち
    | (
        申請準備中 {
            申請者 = 従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") },
            予定費用 = 予定費用(
                [
                    費用明細 {
                        費目 = 交通費 {
                            金額 = 金額(100000),
                            出発地 = 出発地("x"),
                            到着地 = 到着地("x")
                        },
