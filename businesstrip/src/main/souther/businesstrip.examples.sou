// フィクスチャをモデル本体から外したいときは、example 専用の付属ファイルに置ける。
// `examples for` で対象モジュールを名指しし、コンパイラが businesstrip.sou の example とマージする。
// import は不要（同一モジュールなので behavior / data を裸で参照できる）。
//
// ここには出張から戻ったあと ── 最終承認と差し戻し ── を置く。出張完了以降の状態は
// 出張申請共通項目 に実費用・出張報告・事前承認履歴が重なって項目がいちばん多く、
// フィクスチャがそのまま状態の全体像になる。
examples for example.businesstrip

// 事前承認を経てきた申請が最終承認まで進む。事前承認あり がそのまま持ち越されているので、
// 完了後も「誰がいつ事前に承認したか」は状態の中に残っている。
example 最終承認する
    | "上長なら最終承認できる" :
        (最終承認待ち
            { 申請者 = 従業員 { 従業員ID = 従業員ID("e-002"), 役職 = 一般社員, 上長ID = 従業員ID("m-001") }
            , 予定費用 = 予定費用 { 明細 =
                [ 費用明細 { 費目 = 交通費 { 金額 = 金額(28000), 出発地 = 出発地("東京"), 到着地 = 到着地("福岡") },
                             負担 = 立替 } ] }
            , 出張先 = 出張先("福岡")
            , 出張目的 = 出張目的("顧客訪問")
            , 出張開始日 = Date("2026-08-03")
            , 出張終了日 = Date("2026-08-05")
            , 実費用 = 実費用 { 明細 =
                [ 費用明細 { 費目 = 交通費 { 金額 = 金額(31000), 出発地 = 出発地("東京"), 到着地 = 到着地("福岡") },
                             負担 = 立替 }
                , 費用明細 { 費目 = 宿泊費 { 金額 = 金額(12000), インボイス登録番号 = インボイス登録番号("T1234567890123") },
                             負担 = 会社カード } ] }
            , 提出日時 = DateTime("2026-07-27T09:00:00")
            , 完了日時 = DateTime("2026-08-05T18:00:00")
            , 出張報告 = 出張報告("訪問して受注")
            , 事前承認 = 事前承認あり { 事前承認日時 = DateTime("2026-07-27T10:00:00"),
                                        事前承認者ID = 従業員ID("m-001") } },
         従業員ID("m-001"), DateTime("2026-08-06T09:00:00"))
            -> 承認完了
    | "上長でなければ承認権限なし" :
        (最終承認待ち
            { 申請者 = 従業員 { 従業員ID = 従業員ID("e-002"), 役職 = 一般社員, 上長ID = 従業員ID("m-001") }
            , 予定費用 = 予定費用 { 明細 =
                [ 費用明細 { 費目 = 交通費 { 金額 = 金額(28000), 出発地 = 出発地("東京"), 到着地 = 到着地("福岡") },
                             負担 = 立替 } ] }
            , 出張先 = 出張先("福岡")
            , 出張目的 = 出張目的("顧客訪問")
            , 出張開始日 = Date("2026-08-03")
            , 出張終了日 = Date("2026-08-05")
            , 実費用 = 実費用 { 明細 =
                [ 費用明細 { 費目 = 交通費 { 金額 = 金額(31000), 出発地 = 出発地("東京"), 到着地 = 到着地("福岡") },
                             負担 = 立替 } ] }
            , 提出日時 = DateTime("2026-07-27T09:00:00")
            , 完了日時 = DateTime("2026-08-05T18:00:00")
            , 出張報告 = 出張報告("訪問して受注")
            , 事前承認 = 事前承認なし },
         従業員ID("m-999"), DateTime("2026-08-06T09:00:00"))
            -> 承認権限なし

// 却下された申請はシステムが 申請準備中 に戻す。却下理由・却下者ID・提出日時はどれも
// 持ち越さない ── 戻った先の 申請準備中 は 出張申請共通項目 しか持たないので、型がそれを強制する。
example 差し戻す
    | "事前承認の却下から申請準備中へ戻る" :
        (事前承認却下済み
            { 申請者 = 従業員 { 従業員ID = 従業員ID("e-002"), 役職 = 一般社員, 上長ID = 従業員ID("m-001") }
            , 予定費用 = 予定費用 { 明細 =
                [ 費用明細 { 費目 = 交際費 { 金額 = 金額(20000), 使用人数 = 使用人数(4) },
                             負担 = 先方負担 } ] }
            , 出張先 = 出張先("横浜")
            , 出張目的 = 出張目的("打合せ")
            , 出張開始日 = Date("2026-08-03")
            , 出張終了日 = Date("2026-08-03")
            , 提出日時 = DateTime("2026-07-27T09:00:00")
            , 却下日時 = DateTime("2026-07-27T10:00:00")
            , 却下理由 = 却下理由("先方負担の内訳を明細に分けること")
            , 却下者ID = 従業員ID("m-001") })
            -> 申請準備中
