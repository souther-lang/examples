// 規程の写しである businesstrip.sou に対して、`souther examples --generate` が返した行に
// 答えを入れたもの。答えは各 behavior の本体と、そこに書いた規程から決めた。
examples for example.businesstrip

example 費用明細リストの合計を計算する
    | "明細[*].負担=仮払い"
        : (
            [
                費用明細 {
                    費目 = 交通費 { 金額 = 金額(0), 出発地 = 出発地("x"), 到着地 = 到着地("x") },
                    負担 = 仮払い
                }
            ]
        )
        -> 金額(0)
    | "明細[*].負担=会社カード"
        : (
            [
                費用明細 {
                    費目 = 交通費 { 金額 = 金額(0), 出発地 = 出発地("x"), 到着地 = 到着地("x") },
                    負担 = 会社カード
                }
            ]
        )
        -> 金額(0)
    | "明細[*].負担=先方負担"
        : (
            [
                費用明細 {
                    費目 = 交通費 { 金額 = 金額(0), 出発地 = 出発地("x"), 到着地 = 到着地("x") },
                    負担 = 先方負担
                }
            ]
        )
        -> 金額(0)
    | "明細[*].費目=宿泊費"
        : (
            [
                費用明細 {
                    費目 = 宿泊費 {
                        金額 = 金額(0),
                        インボイス登録番号 = インボイス登録番号("T0000000000000")
                    },
                    負担 = 立替
                }
            ]
        )
        -> 金額(0)
    | ([費用明細 { 費目 = 交際費 { 金額 = 金額(0), 使用人数 = 使用人数(2) }, 負担 = 立替 }]) -> 金額(0)
    | ([費用明細 { 費目 = その他費用 { 金額 = 金額(0), 費目名 = 費目名("xx") }, 負担 = 立替 }])
        -> 金額(0)

example 事前承認要否を判定する
    | "予定費用[*].負担=仮払い"
        : (
            予定費用(
                [
                    費用明細 {
                        費目 = 交通費 {
                            金額 = 金額(0),
                            出発地 = 出発地("x"),
                            到着地 = 到着地("x")
                        },
                        負担 = 仮払い
                    }
                ]
            ),
            管理職の申請者
        )
        -> 事前承認理由リスト([])
    | "予定費用[*].負担=会社カード"
        : (
            予定費用(
                [
                    費用明細 {
                        費目 = 交通費 {
                            金額 = 金額(0),
                            出発地 = 出発地("x"),
                            到着地 = 到着地("x")
                        },
                        負担 = 会社カード
                    }
                ]
            ),
            管理職の申請者
        )
        -> 事前承認理由リスト([])
    | "予定費用[*].負担=先方負担"
        : (
            予定費用(
                [
                    費用明細 {
                        費目 = 交通費 {
                            金額 = 金額(0),
                            出発地 = 出発地("x"),
                            到着地 = 到着地("x")
                        },
                        負担 = 先方負担
                    }
                ]
            ),
            管理職の申請者
        )
        -> 事前承認理由リスト([先方費用負担])
    | "予定費用[*].費目=宿泊費"
        : (
            予定費用(
                [
                    費用明細 {
                        費目 = 宿泊費 {
                            金額 = 金額(0),
                            インボイス登録番号 = インボイス登録番号("T0000000000000")
                        },
                        負担 = 立替
                    }
                ]
            ),
            管理職の申請者
        )
        -> 事前承認理由リスト([])
    | "予定費用[*].費目=交際費"
        : (
            予定費用(
                [費用明細 { 費目 = 交際費 { 金額 = 金額(0), 使用人数 = 使用人数(1) }, 負担 = 立替 }]
            ),
            管理職の申請者
        )
        -> 事前承認理由リスト([])
    | "予定費用[*].費目=その他費用"
        : (
            予定費用(
                [
                    費用明細 {
                        費目 = その他費用 { 金額 = 金額(0), 費目名 = 費目名("x") },
                        負担 = 立替
                    }
                ]
            ),
            管理職の申請者
        )
        -> 事前承認理由リスト([])
    | "申請者.役職=一般社員"
        : (
            予定費用(
                [
                    費用明細 {
                        費目 = 交通費 {
                            金額 = 金額(0),
                            出発地 = 出発地("x"),
                            到着地 = 到着地("x")
                        },
                        負担 = 立替
                    }
                ]
            ),
            一般社員の申請者
        )
        -> 事前承認理由リスト([権限不足 { 役職 = 一般社員 }])
    | (
        予定費用(
            [
                費用明細 {
                    費目 = 交通費 {
                        金額 = 金額(100000),
                        出発地 = 出発地("x"),
                        到着地 = 到着地("x")
                    },
                    負担 = 立替
                }
            ]
        ),
        従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") }
    )
        -> 事前承認理由リスト([高額出張 { 基準金額 = 金額(100000) }])
    | (
        予定費用(
            [
                費用明細 {
                    費目 = 交通費 {
                        金額 = 金額(99999),
                        出発地 = 出発地("x"),
                        到着地 = 到着地("x")
                    },
                    負担 = 立替
                }
            ]
        ),
        従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") }
    )
        -> 事前承認理由リスト([])
    | (
        予定費用(
            [
                費用明細 {
                    費目 = 交通費 {
                        金額 = 金額(100001),
                        出発地 = 出発地("x"),
                        到着地 = 到着地("x")
                    },
                    負担 = 立替
                }
            ]
        ),
        従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") }
    )
        -> 事前承認理由リスト([高額出張 { 基準金額 = 金額(100000) }])

