example 事前承認する
// fills 申請.予定費用[*].負担=立替
// fills 申請.予定費用[*].費目=交通費
// fills 申請.事前承認理由リスト[*]=権限不足
// fills 申請.事前承認理由リスト[*]@権限不足.役職=一般社員
// fills 申請.申請者.役職=一般社員
    | (事前承認を待つ横浜出張, 従業員ID("x"), DateTime("2000-01-01T00:00:00")) -> 承認権限なし
    | "申請.予定費用[*].負担=仮払い"
        : (
            事前承認待ち {
                申請者 = 従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") },
                予定費用 = 予定費用(
                    [
                        費用明細 {
                            費目 = 交通費 {
                                金額 = 金額(0),
                                出発地 = 出発地("x"),
                                到着地 = 到着地("x")
                            },
                            負担 = 仮払い
                        }
                    ]
                ),
                出張先 = 出張先("x"),
                出張目的 = 出張目的("x"),
                出張開始日 = Date("2000-01-01"),
                出張終了日 = Date("2000-01-01"),
                提出日時 = DateTime("2000-01-01T00:00:00"),
                事前承認理由リスト = 事前承認理由リスト([高額出張 { 基準金額 = 金額(0) }])
            },
            従業員ID("x"),
            DateTime("2000-01-01T00:00:00")
        )
        -> 事前承認済み
    | "申請.予定費用[*].負担=会社カード"
        : (
            事前承認待ち {
                申請者 = 従業員 { 従業員ID = 従業員ID("x"), 役職 = 管理職, 上長ID = 従業員ID("x") },
                予定費用 = 予定費用(
                    [
