;; Clojure + Pedestal front for the Souther `account` module.
;;
;; `target/classes` is on the classpath: it holds the types SoutherProcessor generates from
;; account.sou (現在残高 / 残高を更新する / 出金する ...). Generate them first with
;;   clojure -X:gen
;; then run the app with `clojure -M:run` or the tests with `clojure -X:test`.
;; souther-clj is the Clojure interop layer (souther.decode / encode / behavior / match / build). It
;; used to be vendored here as `souther-clj/src`; it now lives in its own repository and arrives as a
;; dependency like anything else, which is what this example is meant to show — using Souther from
;; Clojure needs a library you depend on, not a directory you copy.
{:paths ["src/main/clojure" "target/classes"]

 :deps {org.clojure/clojure {:mvn/version "1.12.1"}

        org.souther-lang/souther-clj {:mvn/version "0.1.0"}

        ;; the Souther runtime + Raoh codecs the generated classes call into
        org.souther-lang/souther-runtime {:mvn/version "0.1.0-rc5"}
        net.unit8.raoh/raoh {:mvn/version "0.7.0"}
        tools.jackson.core/jackson-databind {:mvn/version "3.1.5"}

        io.pedestal/pedestal.service {:mvn/version "0.6.4"}
        io.pedestal/pedestal.jetty {:mvn/version "0.6.4"}
        cheshire/cheshire {:mvn/version "5.13.0"}

        com.github.seancorfield/next.jdbc {:mvn/version "1.3.939"}
        com.h2database/h2 {:mvn/version "2.3.232"}

        org.slf4j/slf4j-nop {:mvn/version "2.0.13"}}

 :aliases
 {;; Generate the Souther classes without Maven: runs SoutherProcessor via the JDK compiler API.
  ;; `clojure -X:gen` reads src/main/souther and writes target/classes. souther-compiler is only
  ;; on this alias's classpath (discovered by ServiceLoader), never in the app runtime.
  ;;
  ;; :replace-paths empties the path list for this alias. What it is dropping is target/classes: it
  ;; holds the classes the last run wrote, and a module the compiler is compiling may not also be on
  ;; its path — one name cannot mean two modules — so leaving it there makes every run after the
  ;; first fail. souther.build comes from the souther-clj dependency, which :replace-paths does not
  ;; touch.
  :gen {:replace-paths []
        :extra-deps {org.souther-lang/souther-compiler {:mvn/version "0.1.0-rc5"}}
        :exec-fn souther.build/generate!
        :exec-args {:source-dir "src/main/souther"
                    :trigger-dir "src/main/java"
                    :class-dir "target/classes"}}

  :run {:main-opts ["-m" "account.server"]}

  :test {:extra-paths ["src/test/clojure"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn cognitect.test-runner.api/test
         :exec-args {:dirs ["src/test/clojure"]}}}}
