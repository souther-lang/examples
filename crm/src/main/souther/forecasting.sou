// Forecasting: what the pipeline is worth once every deal is weighed by how likely it is, cut by the period
// it will close in, and held against what the rep was asked for.
//
// This module sits at the bottom of the diamond — it imports crm, pipeline and activity, and reaches crm's
// Amount by three routes that are all the same Amount, because a module is resolved once per compile. It is
// also the one module here with no `exposing` clause, and the two choices are worth seeing side by side:
// example.quoting writes a list although nothing imports it, and this one omits it although nothing imports
// it either. Omitting makes every generated class public, which is what the Java side wants when everything
// in the module is a report somebody reads; writing one is a statement about which names are the module's
// interface. Nothing here is anybody's interface. Every rollup is an endpoint.
//
// What is on show:
//   - A map key the domain *builds* rather than receives. FiscalPeriod is "FY26-Q3", assembled from the
//     close date and the org's fiscal-year start month, and its own regex then checks the result exactly as
//     it would check one that arrived from outside.
//   - `Decimal` arithmetic where the rounding is named at the call: a weighted figure is
//     probability × amount ÷ 100, and dividing by a hundred is the one division in the project that has to be
//     a division, so the scale and the mode are stated where it happens.
//   - `Map.upsert` where the absent branch inserts this deal's own figure and the present branch adds to it.
//     Writing a zero into the absent branch and adding afterwards would lose the first deal of every period.
//   - `Map.union`'s absence as the lesson. A manager's forecast is the reps' forecasts summed, and union is
//     left-biased and never merges values, so it would silently drop a rep's number on a shared period.
//     Combining two values under one key is a domain decision, and this is where it lives.
//   - A two-argument injected behavior, which is the third generated shape after pipeline's zero-argument one
//     and crm's one-argument one.
//   - An optional read as a business outcome: a period with no deals in it is NoForecastForPeriod, not a
//     forecast of zero, because the two mean different things to whoever is being asked about the quarter.
//   - A rollup keyed by a sum. ForecastCategory's five cases are all unit data, so the category itself keys
//     the map and the five names are written once, where they are declared.
//
// Findings recorded here: F5 at attainmentOf. F3, F16 and F23 were recorded here too and are gone: a sum
// whose cases are all unit data keys a boundary map, a field every case spreads is read on the sum, and a
// helper `let` reaches a behavior whose requirement set is empty the same way a behavior's own body does.
module example.forecasting
import example.crm ( Amount, UserId, AccountId, CurrencyCode )
import example.pipeline ( OpportunityId, OpportunityName, Opportunity, OpenOpportunity, ClosedWon
                        , Prospecting, Qualification, NeedsAnalysis, ValueProposition
                        , IdDecisionMakers, PerceptionAnalysis, ProposalPriceQuote, NegotiationReview
                        , ClosedLost, ForecastCategory, Pipeline, BestCase, Commit, Closed, Omitted
                        , categoryOf, probabilityOf )
import example.activity ( StaleReport )

// === Values ===

// "FY26-Q3". Built by periodOf rather than received, and legal as a boundary map key because it is a
// String-backed newtype — which is the whole reason the period is a string and not a product of a year and a
// quarter. A product cannot be a key, so a shape that would have been two Ints is one formatted string, and
// the format is a rule rather than a convention.
data FiscalPeriod = String
    invariant String.matches("FY[0-9]{2}-Q[1-4]", value)

// A zero quota is not a target, so it is not a quota.
data Quota = Decimal
    invariant value > 0.0m

// Attainment as a percentage. It runs past a hundred, because a rep who beats quota has beaten it, and it
// stops at 999 because a figure past that is a data error rather than a quarter.
data Attainment = Int
    invariant value >= 0 && value <= 999

// === Reports ===

data Forecast =
    { owner: UserId
    , periods: List<FiscalPeriod>
    , byPeriod: Map<FiscalPeriod, Amount>
    , total: Amount
    , dealCount: Int
    }

// Keyed by the category itself. Every case of ForecastCategory is a unit data, so it travels as that
// case's name and keys a boundary map directly — the five names are written once, where they are declared.
// A CategoryName newtype stood here and the match that produced it wrote them a second time (finding F3).
data CategoryRollup =
    { byCategory: Map<ForecastCategory, Amount>
    , countByCategory: Map<ForecastCategory, Int>
    }

data RiskReport =
    { atRisk: List<OpportunityId>
    , atRiskAmount: Amount
    , healthy: Int
    }

data Leaderboard = { owners: List<UserId> }

data OnTrack      = { attainment: Attainment }
data ShortOfQuota = { gap: Amount, attainment: Attainment }

// === periodOf: the key the domain builds ===
// Salesforce's fiscal year starts in a month the org chooses, so the month is a parameter rather than a
// constant. The year is the calendar year the fiscal year starts in; the quarter counts from that month.
//
// This is where Date.year and Date.month earn their place, and where the result being checked by the
// newtype's own invariant matters: the string this behavior assembles goes through exactly the check a string
// arriving from a boundary would.
let fiscalYearOf (d: Date, fyStart: Int): Int =
    if Date.month(d) >= fyStart then Date.year(d) else Date.year(d) - 1

let quarterOf (d: Date, fyStart: Int): Int =
    Int.modBy(12, Date.month(d) - fyStart + 12) / 3 + 1

let periodLabel (d: Date, fyStart: Int): String =
    "FY" ++ String.padLeft(2, "0", String.fromInt(Int.modBy(100, fiscalYearOf(d, fyStart))))
         ++ "-Q" ++ String.fromInt(quarterOf(d, fyStart))

behavior periodOf : (closeDate: Date, fiscalYearStartMonth: Int) -> FiscalPeriod | InvalidFiscalYearStart
    constructs FiscalPeriod, InvalidFiscalYearStart

let periodOf (closeDate, fiscalYearStartMonth) = {
    guard fiscalYearStartMonth >= 1 && fiscalYearStartMonth <= 12 else InvalidFiscalYearStart
    FiscalPeriod(periodLabel(closeDate, fiscalYearStartMonth))
}

example periodOf
    | "a calendar fiscal year puts the end of September in the third quarter" :
        (Date("2026-09-30"), 1)
        -> FiscalPeriod("FY26-Q3")
    | "an April fiscal year puts the same date in the second" :
        (Date("2026-09-30"), 4)
        -> FiscalPeriod("FY26-Q2")
    | "a date before an April fiscal year's start belongs to the year that started" :
        (Date("2026-03-31"), 4)
        -> FiscalPeriod("FY25-Q4")
    | "the first day of a fiscal year is its first quarter" :
        (Date("2026-04-01"), 4)
        -> FiscalPeriod("FY26-Q1")
    | "there is no thirteenth month, and that is a case rather than an abort" :
        (Date("2026-09-30"), 13)
        -> InvalidFiscalYearStart

// === Reading a deal ===
// An imported behavior that depends on nothing is called by name, and categoryRollupOf below does exactly that
// with example.pipeline's categoryOf — which is why the forecast category is not mapped a second time here.
// weightedOf below reaches probabilityOf the same way, from a helper `let` rather than a behavior's own
// body, which is what retired finding F23: the stage-probability mapping used to be copied into this module
// because a helper could not call a behavior across a module boundary, and nothing but a comment kept the
// copy in step with the stage machine that owns it.

// The amount, the close date, the id and the account are read straight off OpenOpportunity: every one of
// the eight open states spreads OpportunityCommon, and what holds of every case is a property of the sum.
// Four eight-arm helpers stood here, which was finding F16.

// === The deal and the forecast the rows are about ===
// One deal of a million yen closing at the end of September, and the forecast that comes to. The deal is
// written flat, because a row hands it to a list of the OpenOpportunity union and a fixture built by a
// spread arrives there as the case it spread (souther#206); the rows vary the amount and the close date by
// spreading it.
let acmeDeal = Prospecting
    { id = OpportunityId("006000000000001")
    , accountId = AccountId("001000000000100")
    , name = OpportunityName("Acme Corp — New Business")
    , owner = UserId("u-001")
    , amount = Amount(1000000.00m)
    , currency = CurrencyCode("JPY")
    , closeDate = Date("2026-09-30")
    , openedOn = Date("2026-07-20")
    }

// A hundred and fifty thousand in the third quarter, which is the figure every quota row is held against.
let q3Forecast = Forecast
    { owner = UserId("u-001")
    , periods = [ FiscalPeriod("FY26-Q3") ]
    , byPeriod = Map.fromList([ (FiscalPeriod("FY26-Q3"), Amount(150000.00m)) ])
    , total = Amount(150000.00m)
    , dealCount = 1
    }

// === weightedForecast ===
// The weighted figure is probability × amount ÷ 100, and this is the one place in the project where a division
// is the arithmetic rather than a way of writing a ratio. So the scale and the rounding mode are named at the
// call, once per deal, and the answer is a Decimal rather than a union because the denominator is a literal
// hundred and cannot be zero.
let weightedOf (opp: OpenOpportunity): Decimal =
    Decimal.round(Decimal.fromInt(probabilityOf(opp).value) * opp.amount.value * 0.01m, 2, HALF_UP)

let addToPeriod (acc: Map<FiscalPeriod, Decimal>, opp: OpenOpportunity, fyStart: Int)
        : Map<FiscalPeriod, Decimal> = {
    let period = FiscalPeriod(periodLabel(opp.closeDate, fyStart))
    let weighted = weightedOf(opp)
    Map.upsert(period, weighted, running -> Decimal.add(running, weighted), acc)
}

behavior weightedForecast : (owner: UserId, opps: List<OpenOpportunity>, fiscalYearStartMonth: Int)
        -> Forecast | InvalidFiscalYearStart
    constructs Forecast, FiscalPeriod, Amount, InvalidFiscalYearStart

let weightedForecast (owner, opps, fiscalYearStartMonth) = {
    guard fiscalYearStartMonth >= 1 && fiscalYearStartMonth <= 12 else InvalidFiscalYearStart
    let byPeriod: Map<FiscalPeriod, Decimal> =
        List.fold((acc, opp) -> addToPeriod(acc, opp, fiscalYearStartMonth), Map.empty(), opps)
    Forecast { owner = owner
             , periods = List.sort(Map.keys(byPeriod))
             , byPeriod = Map.map((period, weighted) -> Amount(weighted), byPeriod)
             , total = Amount(List.fold((acc, w) -> Decimal.add(acc, w), 0.0m,
                                                Map.values(byPeriod)))
             , dealCount = List.length(opps)
             }
}

example weightedForecast
    | "a deal in the first stage weighs a tenth of itself, in the quarter it closes in" :
        (UserId("u-001"), [ acmeDeal ], 1)
        -> Forecast
            { owner = UserId("u-001")
            , periods = [ FiscalPeriod("FY26-Q3") ]
            , byPeriod = [ (FiscalPeriod("FY26-Q3"), Amount(100000.00m)) ]
            , total = Amount(100000.00m)
            , dealCount = 1
            }
    | "two deals in one quarter add up rather than replacing each other" :
        (UserId("u-001"),
         [ acmeDeal
         , Prospecting { ...acmeDeal, id = OpportunityId("006000000000002")
                       , amount = Amount(500000.00m), closeDate = Date("2026-08-31") } ],
         1)
        -> Forecast
            { owner = UserId("u-001")
            , periods = [ FiscalPeriod("FY26-Q3") ]
            , byPeriod = [ (FiscalPeriod("FY26-Q3"), Amount(150000.00m)) ]
            , total = Amount(150000.00m)
            , dealCount = 2
            }
    | "an empty pipeline is a forecast of nothing, not a missing forecast" :
        (UserId("u-001"), [ ], 1)
        -> Forecast
            { owner = UserId("u-001")
            , periods = [ ]
            , byPeriod = [ ]
            , total = Amount(0.0m)
            , dealCount = 0
            }
    | "there is still no thirteenth month" :
        (UserId("u-001"), [ ], 13)
        -> InvalidFiscalYearStart

// === categoryRollup ===
// The forecast categories are what a sales manager reads before the numbers: pipeline is everything, best case
// is what could happen, commit is what the rep is promising, closed is done. The category comes from the
// stage, so the sum is example.pipeline's — and the key is this module's string, because a sum is not a key.
// A won deal weighs what it was won at, which is the one thing the spread does not say, so this one still
// opens the value. The nine that weigh the ask share an arm, and naming them keeps the compile error a new
// stage causes here.
let amountOfAny (opp: Opportunity): Decimal =
    match opp with
        | ClosedWon { wonAmount } -> wonAmount.value
        | Prospecting | Qualification | NeedsAnalysis | ValueProposition | IdDecisionMakers
        | PerceptionAnalysis | ProposalPriceQuote | NegotiationReview | ClosedLost -> opp.amount.value

behavior categoryRollupOf : (opps: List<Opportunity>) -> CategoryRollup
    constructs CategoryRollup, Amount

let categoryRollupOf (opps) = {
    let money: Map<ForecastCategory, Decimal> =
        List.fold((acc, opp) -> Map.upsert(categoryOf(opp), amountOfAny(opp),
                                           running -> Decimal.add(running, amountOfAny(opp)), acc),
                  Map.empty(), opps)
    CategoryRollup
        { byCategory = Map.map((category, total) -> Amount(total), money)
        , countByCategory = List.fold((acc, opp) -> Map.upsert(categoryOf(opp), 1, n -> n + 1, acc),
                                      Map.empty(), opps)
        }
}

// === commitNumber ===
// The number a rep is actually held to: negotiation only. Everything earlier is a hope and everything closed
// is history.
let isCommit (opp: OpenOpportunity): Bool =
    match opp with
        | NegotiationReview  -> true
        | Prospecting        -> false
        | Qualification      -> false
        | NeedsAnalysis      -> false
        | ValueProposition   -> false
        | IdDecisionMakers   -> false
        | PerceptionAnalysis -> false
        | ProposalPriceQuote -> false

behavior commitNumber : (opps: List<OpenOpportunity>) -> Amount
    constructs Amount

let commitNumber (opps) =
    Amount(List.fold((acc, opp) -> Decimal.add(acc, opp.amount.value), 0.0m,
                             List.filter(opp -> isCommit(opp), opps)))

// === quotaFor and attainment ===
// Quotas live in the compensation system, which is administered by a different team on a different cycle, so
// the lookup is injected. Two inputs, which makes its generated base the third injected shape in the project:
// a standalone abstract class with apply(UserId, FiscalPeriod).
behavior quotaFor : (owner: UserId, period: FiscalPeriod) -> Quota

// A period with no deals is not a forecast of zero. The difference matters to the person being asked about the
// quarter, so the optional Map.get answers with is opened into a named case rather than defaulted.
//
// The attainment is a percentage of quota, and it is the one figure here computed by dividing a Decimal by a
// Decimal — so the guard above makes the zero denominator unreachable and the operator is used with the
// rounding named. No DivisionByZero case appears in the output, because the model does not carry a case it can
// never return. Finding F5.
let attainmentOf (forecast: Decimal, quota: Decimal): Attainment =
    Attainment(Int.clamp(0, 999,
        Decimal.toInt(Decimal.round(forecast * 100.0m, 0, HALF_UP), FLOOR) / Decimal.toInt(quota, FLOOR)))

behavior quotaGap : (forecast: Forecast, quota: Quota, period: FiscalPeriod)
        -> OnTrack | ShortOfQuota | NoForecastForPeriod
    constructs OnTrack, ShortOfQuota, NoForecastForPeriod, Amount, Attainment

let quotaGap (forecast, quota, period) =
    match Map.get(period, forecast.byPeriod) with
        | None -> NoForecastForPeriod
        | Some got ->
            if Decimal.compare(got.value, quota.value) >= 0
            then OnTrack { attainment = attainmentOf(got.value, quota.value) }
            else ShortOfQuota { gap = Amount(Decimal.subtract(quota.value, got.value))
                              , attainment = attainmentOf(got.value, quota.value)
                              }

example quotaGap
    | "a quarter above quota is on track, and says by how much of it" :
        (q3Forecast, Quota(100000.00m), FiscalPeriod("FY26-Q3"))
        -> OnTrack { attainment = Attainment(150) }
    | "a quarter under quota names the gap rather than a percentage alone" :
        (q3Forecast, Quota(200000.00m), FiscalPeriod("FY26-Q3"))
        -> ShortOfQuota { gap = Amount(50000.00m), attainment = Attainment(75) }
    | "a quarter with no deals in it has no forecast, which is not a forecast of nothing" :
        (q3Forecast, Quota(100000.00m), FiscalPeriod("FY26-Q4"))
        -> NoForecastForPeriod

// The same question with the quota read rather than passed: read, compute, answer. This is the shape every
// behavior in this project that touches the outside world has, and the only reason quotaGap exists beside it is
// that a caller who already knows the quota should not have to inject a lookup to say so.
behavior attainmentFor : (owner: UserId, forecast: Forecast, period: FiscalPeriod)
        -> OnTrack | ShortOfQuota | NoForecastForPeriod
    depends on quotaFor
    constructs OnTrack, ShortOfQuota, NoForecastForPeriod, Amount, Attainment

let attainmentFor (owner, forecast, period, quotaFor) =
    match Map.get(period, forecast.byPeriod) with
        | None -> NoForecastForPeriod
        | Some got -> {
            let quota = quotaFor(owner, period)
            if Decimal.compare(got.value, quota.value) >= 0
            then OnTrack { attainment = attainmentOf(got.value, quota.value) }
            else ShortOfQuota { gap = Amount(Decimal.subtract(quota.value, got.value))
                              , attainment = attainmentOf(got.value, quota.value)
                              }
        }

// The comp plan as a table. The `_` row is every other rep and every other quarter, which is what makes the
// happy path a path rather than the only path.
fake quotaFor
    | (UserId("u-001"), FiscalPeriod("FY26-Q3")) -> Quota(100000.00m)
    | _                                         -> Quota(500000.00m)

example attainmentFor
    | "the rep's own quota for that quarter is what the forecast is held against" :
        (UserId("u-001"), q3Forecast, FiscalPeriod("FY26-Q3"))
        -> OnTrack { attainment = Attainment(150) }
    | "another rep is held against another number, and the same forecast falls short of it" :
        (UserId("u-002"), Forecast { ...q3Forecast, owner = UserId("u-002") },
         FiscalPeriod("FY26-Q3"))
        -> ShortOfQuota { gap = Amount(350000.00m), attainment = Attainment(30) }

// === dealsAtRisk ===
// A commit-category deal with no activity inside the cadence is the deal inspection question. It reads
// example.activity's report and answers with example.forecasting's case: a context that has nothing to say
// states its own silence, rather than passing activity's NeverTouched through a union declared here.
let staleDaysOf (opp: OpenOpportunity, stale: StaleReport): Int =
    Option.withDefault(0, Map.get(opp.accountId, stale.daysSince))

behavior dealsAtRisk : (opps: List<OpenOpportunity>, stale: StaleReport, staleAfter: Int)
        -> RiskReport | NoActivityRecorded
    constructs RiskReport, Amount, NoActivityRecorded

let dealsAtRisk (opps, stale, staleAfter) = {
    guard Map.size(stale.daysSince) >= 1 else NoActivityRecorded
    let (risky, healthy) =
        List.partition(opp -> isCommit(opp) && staleDaysOf(opp, stale) >= staleAfter, opps)
    RiskReport { atRisk = List.map(opp -> opp.id, risky)
               , atRiskAmount = Amount(List.fold((acc, opp) -> Decimal.add(acc, opp.amount.value),
                                                         0.0m, risky))
               , healthy = List.length(healthy)
               }
}

// === rollupTeam ===
// A manager's number is the reps' numbers summed, and Map.union is the wrong tool for it: union is left-biased
// and never merges values, so two reps with deals in the same quarter would leave one of them out of the
// manager's forecast entirely — silently, and by the same amount every quarter. Combining two values under one
// key is a domain decision, so the rollup is a fold with upsert and the decision is written down here.
let mergeForecast (acc: Map<FiscalPeriod, Decimal>, one: Forecast): Map<FiscalPeriod, Decimal> =
    List.fold((inner, entry) -> mergeEntry(inner, entry), acc, Map.toList(one.byPeriod))

let mergeEntry (acc: Map<FiscalPeriod, Decimal>, entry: (FiscalPeriod, Amount))
        : Map<FiscalPeriod, Decimal> = {
    let (period, amount) = entry
    Map.upsert(period, amount.value, running -> Decimal.add(running, amount.value), acc)
}

behavior rollupTeam : (manager: UserId, forecasts: List<Forecast>) -> Forecast
    constructs Forecast, Amount

let rollupTeam (manager, forecasts) = {
    let byPeriod: Map<FiscalPeriod, Decimal> =
        List.fold((acc, one) -> mergeForecast(acc, one), Map.empty(), forecasts)
    Forecast { owner = manager
             , periods = List.sort(Map.keys(byPeriod))
             , byPeriod = Map.map((period, total) -> Amount(total), byPeriod)
             , total = Amount(List.fold((acc, w) -> Decimal.add(acc, w), 0.0m,
                                                Map.values(byPeriod)))
             , dealCount = List.fold((acc, one) -> acc + one.dealCount, 0, forecasts)
             }
}

// === topPerformers ===
// Rank by what each owner closed. The amounts have done their work once the list is in order, so what comes
// back is the owners — a leaderboard is an order, and publishing the figures beside the names is a different
// decision that whoever displays it can make.
let wonByOwner (won: List<ClosedWon>): Map<UserId, Decimal> =
    List.fold((acc, w) -> Map.upsert(w.owner, w.wonAmount.value,
                                     running -> Decimal.add(running, w.wonAmount.value), acc),
              Map.empty(), won)

behavior topPerformers : (won: List<ClosedWon>, n: Int) -> Leaderboard
    constructs Leaderboard

let topPerformers (won, n) = {
    let (owners, amounts) = List.unzip(List.reverse(List.sortBy(entry -> second(entry),
                                                                Map.toList(wonByOwner(won)))))
    Leaderboard { owners = List.take(n, owners) }
}

let second (entry: (UserId, Decimal)): Decimal = {
    let (owner, amount) = entry
    amount
}
