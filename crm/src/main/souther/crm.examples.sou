// Fixtures can live in a companion file when they outgrow the model. `examples for` names the module
// and the compiler merges these rows with the ones written beside the behaviors in crm.sou. No import is
// needed: the same module's data and behaviors are in scope bare, and this file's own values join the
// module the same way — a `let` with no parameter list declares a value here; a `let` with parameters
// would be a helper, which this file may not hold.
//
// Conversion is what earns the companion: every row states a lead, a request and the two books the
// duplicate rules are checked against, and what each row is about is one field of one of them. The lead,
// the request and the empty books are declared in crm.sou, because example.pipeline starts from them too;
// the books with accounts on file are declared here, beside the only rows that use them.
//
// crm.sou keeps the examples for the small transitions, because there the row is shorter than the
// behavior and belongs next to it.
examples for example.crm

// The books a duplicate rule reads. A rule reads a set, so a row has to show the set — which is why the
// books are values too rather than four accounts written per row.
let betaOnFile   = AccountBook([ betaAccount ])
let bothOnFile   = AccountBook([ betaAccount, gammaAccount ])
let aoyagiOnFile = ContactBook([ acmeContact ])

example convertLead
    | "a clean conversion carries the lead's address to the contact and derives the account's domain" :
        (QualifiedLead { ...acmeQualifiedLead
                       , reach = EmailAndPhone { email = EmailAddress("cto@acme.example.com")
                                               , phone = PhoneNumber("+81-3-1234-5678") }
                       , source = PartnerReferral { partner = AccountId("001000000000009") }
                       },
         conversionRequest, betaOnFile, noContacts)
        -> LeadConverted
            { lead = ConvertedLead { ...acmeQualifiedLead
                                   , reach = EmailAndPhone { email = EmailAddress("cto@acme.example.com")
                                                           , phone = PhoneNumber("+81-3-1234-5678") }
                                   , source = PartnerReferral { partner = AccountId("001000000000009") }
                                   , convertedOn = Date("2026-07-20")
                                   , accountId = AccountId("001000000000100")
                                   , contactId = ContactId("003000000000100")
                                   }
            // The domain is derived from the address rather than asked for, and the employee count is
            // what the request said.
            , account = Account { ...acmeAccount
                                , id = AccountId("001000000000100")
                                , employees = EmployeeCount(420)
                                }
            , contact = Contact { ...acmeContact
                                , id = ContactId("003000000000100")
                                , accountId = AccountId("001000000000100")
                                }
            , intent = OpportunityRequested { amount = Amount(4800000.00m), closeDate = Date("2026-09-30") }
            }
    | "filing a lead with no opportunity asked for needs no budget and no close date" :
        (QualifiedLead { ...acmeQualifiedLead, budgetConfirmed = false },
         ConversionRequest { ...conversionRequest, intent = NoOpportunity },
         noAccounts, noContacts)
        -> LeadConverted
    | "an opportunity asked for on an unconfirmed budget is blocked" :
        (QualifiedLead { ...acmeQualifiedLead, budgetConfirmed = false },
         conversionRequest, noAccounts, noContacts)
        -> ConversionBlocked { reasons = [ BudgetNotConfirmed ] }
    | "a close date before the conversion is blocked, and the date it objects to is in the reason" :
        (acmeQualifiedLead,
         ConversionRequest { ...conversionRequest
                           , intent = OpportunityRequested { amount = Amount(500000.00m)
                                                           , closeDate = Date("2026-06-01") }
                           },
         noAccounts, noContacts)
        -> ConversionBlocked { reasons = [ CloseDateInPast { requested = Date("2026-06-01") } ] }
    | "both reasons are reported at once, which is the whole point of collecting them" :
        (QualifiedLead { ...acmeQualifiedLead, budgetConfirmed = false },
         ConversionRequest { ...conversionRequest
                           , intent = OpportunityRequested { amount = Amount(500000.00m)
                                                           , closeDate = Date("2026-06-01") }
                           },
         noAccounts, noContacts)
        -> ConversionBlocked
            { reasons = [ BudgetNotConfirmed
                        , CloseDateInPast { requested = Date("2026-06-01") } ] }
    | "an account already on this domain blocks the conversion and names the account" :
        (QualifiedLead { ...acmeQualifiedLead
                       , reach = EmailOnly { email = EmailAddress("h@beta.example.com") } },
         ConversionRequest { ...conversionRequest, intent = NoOpportunity },
         bothOnFile, noContacts)
        -> ConversionBlocked
            { reasons = [ DuplicateAccount { existing = AccountId("001000000000002") } ] }

// Screening is the same two rules, asked before anybody has been qualified. The two keys are what make
// them two rules: an account is a company, so its key is the domain; a contact is a person, so its key is
// the address.
example screenForDuplicates
    | "an account on the same domain is a possible duplicate" :
        (NewLead { ...acmeNew, reach = EmailOnly { email = EmailAddress("h@beta.example.com") } },
         betaOnFile, noContacts)
        -> PossibleDuplicate { accounts = [ AccountId("001000000000002") ], contacts = [ ] }
    | "a contact on the same address is a possible duplicate, on the other key" :
        (acmeNew, noAccounts, aoyagiOnFile)
        -> PossibleDuplicate { accounts = [ ], contacts = [ ContactId("003000000000001") ] }
    | "a lead reachable only by phone matches neither rule, and that is an answer" :
        (NewLead { ...acmeNew, reach = PhoneOnly { phone = PhoneNumber("+81-3-9999-0000") } },
         noAccounts, noContacts)
        -> NoEmailOnLead
    | "nothing on either key is a clean lead" :
        (NewLead { ...acmeNew, reach = EmailOnly { email = EmailAddress("s@gamma.example.com") } },
         AccountBook([ gammaAccount ]), noContacts)
        -> NoDuplicate
