fake insuranceRatesOf
    | (GeneralBusiness, Date("2026-07-01"))
        -> InsuranceRates { employee = InsuranceRate(0.0055m), employer = InsuranceRate(0.0090m) }
    | _ -> InsuranceRates { employee = InsuranceRate(0.0065m), employer = InsuranceRate(0.0105m) }

let pay300k = MonthlyRemuneration
    { baseSalary = Yen(260000)
    , scheduledAllowances = Yen(20000)
    , commutingAllowance = Yen(15000)
    , excludedAllowances = Yen(5000)
    , variableAllowances = Yen(0)
    }

example employeePremiumFor
    | "300,000 yen at 5.5 per thousand is 1,650 yen, commuting allowance and all" :
        (pay300k, GeneralBusiness, Date("2026-07-01")) -> Yen(1650)
    | "construction pays more, and it is the whole wage that is charged" :
        (pay300k, ConstructionBusiness, Date("2026-07-01")) -> Yen(1950)
    | "the primary industries pay the higher rate as construction does" :
        (pay300k, AgricultureForestryFisheryOrSake, Date("2026-07-01")) -> Yen(1950)
    | "a half of a yen is dropped, not carried: 5.5 yen is 5" :
        (MonthlyRemuneration { ...pay300k, baseSalary = Yen(1000), scheduledAllowances = Yen(0), commutingAllowance = Yen(0), excludedAllowances = Yen(0) }, GeneralBusiness, Date("2026-07-01"))
        -> Yen(5)
    | "and anything above a half is carried: 5.511 yen is 6" :
        (MonthlyRemuneration { ...pay300k, baseSalary = Yen(1002), scheduledAllowances = Yen(0), commutingAllowance = Yen(0), excludedAllowances = Yen(0) }, GeneralBusiness, Date("2026-07-01"))
        -> Yen(6)

example judgeInsuredCategory
    | "somebody of thirty-six is a general insured person" :
        (Date("1990-04-01"), Date("2026-07-01")) -> GeneralInsured
    | "born on 1 August 1961 she attains sixty-five on 31 July 2026, the day before her birthday" :
        (Date("1961-08-01"), Date("2026-07-31")) -> ElderlyInsured
    | "and one day earlier she is still a general insured person" :
        (Date("1961-08-01"), Date("2026-07-30")) -> GeneralInsured
    | "somebody of eighty is an elderly insured person" :
        (Date("1946-01-15"), Date("2026-07-01")) -> ElderlyInsured

