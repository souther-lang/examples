example premiumFor
    | "the halves of a 10,901-yen health premium are 5,450 and 5,451, and the 50-sen rule is why" :
        (Yen(110000), HealthAndPension, LongTermCareInsured, PrefectureCode("13"), Date("2026-07-01"))
        -> Premium { health = PremiumShare { employee = Yen(5450), employer = Yen(5451) }
                   , longTermCare = PremiumShare { employee = Yen(874), employer = Yen(875) }
                   , pension = PremiumShare { employee = Yen(10065), employer = Yen(10065) }
                   }
    | "under forty there is no long-term care, and over seventy no pension" :
        (Yen(110000), HealthOnly, OutsideLongTermCare, PrefectureCode("13"), Date("2026-07-01"))
        -> Premium { health = PremiumShare { employee = Yen(5450), employer = Yen(5451) }
                   , longTermCare = PremiumShare { employee = Yen(0), employer = Yen(0) }
                   , pension = PremiumShare { employee = Yen(0), employer = Yen(0) }
                   }

