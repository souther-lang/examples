let raisedPay = MonthlyRemuneration { ...pay300k, baseSalary = Yen(320000) }

let raisedWindow = ThreeMonthWindow
    { first = MonthlyPayRecord { ...aprilRecord, remuneration = raisedPay }
    , second = MonthlyPayRecord { ...aprilRecord, month = ContributionMonth(Date("2026-05-01")), remuneration = raisedPay }
    , third = MonthlyPayRecord { ...aprilRecord, month = ContributionMonth(Date("2026-06-01")), remuneration = raisedPay }
    }

let overtimeWindow = ThreeMonthWindow
    { first = MonthlyPayRecord { ...aprilRecord
                               , remuneration = MonthlyRemuneration { ...pay300k, variableAllowances = Yen(60000) } }
    , second = MonthlyPayRecord { ...aprilRecord, month = ContributionMonth(Date("2026-05-01"))
                                , remuneration = MonthlyRemuneration { ...pay300k, variableAllowances = Yen(60000) } }
    , third = MonthlyPayRecord { ...aprilRecord, month = ContributionMonth(Date("2026-06-01"))
                               , remuneration = MonthlyRemuneration { ...pay300k, variableAllowances = Yen(60000) } }
    }

example judgeOccasionalRevision
    | "a 60,000-yen raise moves the grade two steps and revises from the fourth month" :
        (currentGrade22, Yen(300000), raisedWindow)
        -> GradeDecision { basis = OccasionalRevision
                         , standard = Yen(360000)
                         , health = HealthGrade(25)
                         , pension = PensionGrade(22)
                         , appliesFrom = ContributionMonth(Date("2026-07-01"))
                         }
    | "three months of the same overtime move the average and revise nothing, because the fixed wage did not change" :
        (currentGrade22, Yen(300000), overtimeWindow)
        -> RevisionNotRequired
    | "a grade decided on acquisition is revised like any other" :
        (GradeDecision { ...currentGrade22, basis = OnAcquisition }, Yen(300000), raisedWindow)
        -> GradeDecision { basis = OccasionalRevision, standard = Yen(360000), health = HealthGrade(25), pension = PensionGrade(22), appliesFrom = ContributionMonth(Date("2026-07-01")) }
    | "a grade already revised once is revised again by the same rule" :
        (GradeDecision { ...currentGrade22, basis = OccasionalRevision }, Yen(300000), raisedWindow)
        -> GradeDecision { basis = OccasionalRevision, standard = Yen(360000), health = HealthGrade(25), pension = PensionGrade(22), appliesFrom = ContributionMonth(Date("2026-07-01")) }
    | "a month of 16 paid base days blocks the revision and is named with its days" :
        (currentGrade22, Yen(300000), ThreeMonthWindow { ...raisedWindow, second = MonthlyPayRecord { ...raisedWindow.second, paidBaseDays = PaidBaseDays(16) } })
        -> RevisionNotRequired { reasons = [ PaidDaysBelowSeventeen { month = ContributionMonth(Date("2026-05-01")), days = PaidBaseDays(16) } ] }
    | "a month of 16 paid base days in April blocks the revision just as it does in May" :
        (currentGrade22, Yen(300000), ThreeMonthWindow { ...raisedWindow, first = MonthlyPayRecord { ...raisedWindow.first, paidBaseDays = PaidBaseDays(16) } })
        -> RevisionNotRequired { reasons = [ PaidDaysBelowSeventeen { month = ContributionMonth(Date("2026-04-01")), days = PaidBaseDays(16) } ] }
    | "a month of 16 paid base days in June blocks the revision just as it does in May" :
        (currentGrade22, Yen(300000), ThreeMonthWindow { ...raisedWindow, third = MonthlyPayRecord { ...raisedWindow.third, paidBaseDays = PaidBaseDays(16) } })
        -> RevisionNotRequired { reasons = [ PaidDaysBelowSeventeen { month = ContributionMonth(Date("2026-06-01")), days = PaidBaseDays(16) } ] }
    | "seventeen paid base days in the first month do not block the revision" :
        (currentGrade22, Yen(300000), ThreeMonthWindow { ...raisedWindow, first = MonthlyPayRecord { ...raisedWindow.first, paidBaseDays = PaidBaseDays(17) } })
        -> GradeDecision { basis = OccasionalRevision, standard = Yen(360000), health = HealthGrade(25), pension = PensionGrade(22), appliesFrom = ContributionMonth(Date("2026-07-01")) }
    | "seventeen paid base days in the second month do not block the revision" :
        (currentGrade22, Yen(300000), ThreeMonthWindow { ...raisedWindow, second = MonthlyPayRecord { ...raisedWindow.second, paidBaseDays = PaidBaseDays(17) } })
        -> GradeDecision { basis = OccasionalRevision, standard = Yen(360000), health = HealthGrade(25), pension = PensionGrade(22), appliesFrom = ContributionMonth(Date("2026-07-01")) }
    | "seventeen paid base days in the third month do not block the revision" :
        (currentGrade22, Yen(300000), ThreeMonthWindow { ...raisedWindow, third = MonthlyPayRecord { ...raisedWindow.third, paidBaseDays = PaidBaseDays(17) } })
        -> GradeDecision { basis = OccasionalRevision, standard = Yen(360000), health = HealthGrade(25), pension = PensionGrade(22), appliesFrom = ContributionMonth(Date("2026-07-01")) }
    | "ten paid base days in the first month are named with their days" :
        (currentGrade22, Yen(300000), ThreeMonthWindow { ...raisedWindow, first = MonthlyPayRecord { ...raisedWindow.first, paidBaseDays = PaidBaseDays(10) } })
        -> RevisionNotRequired { reasons = [ PaidDaysBelowSeventeen { month = ContributionMonth(Date("2026-04-01")), days = PaidBaseDays(10) } ] }
    | "ten paid base days in the third month are named with their days" :
        (currentGrade22, Yen(300000), ThreeMonthWindow { ...raisedWindow, third = MonthlyPayRecord { ...raisedWindow.third, paidBaseDays = PaidBaseDays(10) } })
        -> RevisionNotRequired { reasons = [ PaidDaysBelowSeventeen { month = ContributionMonth(Date("2026-06-01")), days = PaidBaseDays(10) } ] }
    | "a cut in pay moves the grade down by three and the revision follows" :
        (currentGrade22, Yen(300000), evenWindow(MonthlyRemuneration { ...pay300k, baseSalary = Yen(200000) }))
        -> GradeDecision { basis = OccasionalRevision, standard = Yen(240000), health = HealthGrade(19), pension = PensionGrade(16), appliesFrom = ContributionMonth(Date("2026-07-01")) }
    | "one grade of difference is not enough" :
        (currentGrade22, Yen(300000), evenWindow(MonthlyRemuneration { ...pay300k, baseSalary = Yen(270000) }))
        -> RevisionNotRequired { reasons = [ GradeDifferenceBelowTwo { current = HealthGrade(22), computed = HealthGrade(23) } ] }
    | "two grades of difference is enough" :
        (currentGrade22, Yen(300000), evenWindow(MonthlyRemuneration { ...pay300k, baseSalary = Yen(290000) }))
        -> GradeDecision { basis = OccasionalRevision, standard = Yen(340000), health = HealthGrade(24), pension = PensionGrade(21), appliesFrom = ContributionMonth(Date("2026-07-01")) }
    | "an unchanged fixed wage, a short month and a grade that did not move are all reported, in that order" :
        (currentGrade22, Yen(300000), ThreeMonthWindow { first = aprilRecord, second = MonthlyPayRecord { ...aprilRecord, month = ContributionMonth(Date("2026-05-01")), paidBaseDays = PaidBaseDays(10) }, third = MonthlyPayRecord { ...aprilRecord, month = ContributionMonth(Date("2026-06-01")) } })
        -> RevisionNotRequired { reasons = [ FixedWageUnchanged, PaidDaysBelowSeventeen { month = ContributionMonth(Date("2026-05-01")), days = PaidBaseDays(10) }, GradeDifferenceBelowTwo { current = HealthGrade(22), computed = HealthGrade(22) } ] }
    | "a revision to the lowest grade carries pension grade 1" :
        (currentGrade22, Yen(300000), evenWindow(MonthlyRemuneration { ...pay300k, baseSalary = Yen(10000) }))
        -> GradeDecision { basis = OccasionalRevision, standard = Yen(58000), health = HealthGrade(1), pension = PensionGrade(1), appliesFrom = ContributionMonth(Date("2026-07-01")) }
    | "a revision to the highest grade carries pension grade 32" :
        (currentGrade22, Yen(300000), evenWindow(MonthlyRemuneration { ...pay300k, baseSalary = Yen(1360000) }))
        -> GradeDecision { basis = OccasionalRevision, standard = Yen(1390000), health = HealthGrade(50), pension = PensionGrade(32), appliesFrom = ContributionMonth(Date("2026-07-01")) }

