// A window of three months on one pay, from April.
let evenWindow (pay: MonthlyRemuneration): ThreeMonthWindow = ThreeMonthWindow
    { first = MonthlyPayRecord { ...aprilRecord, remuneration = pay }
    , second = MonthlyPayRecord { ...aprilRecord, month = ContributionMonth(Date("2026-05-01")), remuneration = pay }
    , third = MonthlyPayRecord { ...aprilRecord, month = ContributionMonth(Date("2026-06-01")), remuneration = pay }
    }

