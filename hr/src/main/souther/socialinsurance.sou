example premiumFor
    | "the halves of a 10,901-yen health premium are 5,450 and 5,451, and the 50-sen rule is why" :
        (Yen(110000), HealthAndPension, LongTermCareInsured, PrefectureCode("13"), Date("2026-07-01"))
        -> Premium { health = PremiumShare { employee = Yen(5450), employer = Yen(5451) }
                   , longTermCare = PremiumShare { employee = Yen(874), employer = Yen(875) }
                   , pension = PremiumShare { employee = Yen(10065), employer = Yen(10065) }
                   }
    | "under forty there is no long-term care, and over seventy no pension" :
        (Yen(110000), HealthOnly, OutsideLongTermCare, PrefectureCode("13"), Date("2026-07-01"))
        -> Premium { health = PremiumShare { employee = Yen(5450), employer = Yen(5451) }
                   , longTermCare = PremiumShare { employee = Yen(0), employer = Yen(0) }
                   , pension = PremiumShare { employee = Yen(0), employer = Yen(0) }
                   }

let lowWagePay = MonthlyRemuneration { ...pay110k, baseSalary = Yen(82999), scheduledAllowances = Yen(5000) }
let floorWagePay = MonthlyRemuneration { ...pay110k, baseSalary = Yen(83000), scheduledAllowances = Yen(5000) }
let fiftyOffice = Office { ...smallOffice, insuredCount = 50 }
let fiftyOneOffice = Office { ...smallOffice, insuredCount = 51 }

// A window of three months on one pay, from April.
let evenWindow (pay: MonthlyRemuneration): ThreeMonthWindow = ThreeMonthWindow
    { first = MonthlyPayRecord { ...aprilRecord, remuneration = pay }
    , second = MonthlyPayRecord { ...aprilRecord, month = ContributionMonth(Date("2026-05-01")), remuneration = pay }
    , third = MonthlyPayRecord { ...aprilRecord, month = ContributionMonth(Date("2026-06-01")), remuneration = pay }
    }

let insuredFullTime = Insured
    { acquiredOn = Date("2020-04-01")
    , scope = HealthAndPension
    , route = RegularRoute
    , decision = currentGrade22
    }

let insuredShortTime = Insured { ...insuredFullTime, route = ShortTimeRoute }
let insuredHealthOnly = Insured { ...insuredFullTime, scope = HealthOnly }
let insuredOnAcquisition = Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, basis = OnAcquisition } }
let insuredRevised = Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, basis = OccasionalRevision } }

let ratesTokyo = ContributionRates
    { health = ContributionRate(0.0991m)
    , longTermCare = ContributionRate(0.0159m)
    , pension = ContributionRate(0.183m)
    }

let hanakoIdentity = example.employee.PersonalIdentity
    { id = example.employee.EmployeeId("000123")
    , birthday = Date("1990-04-01")
    , sex = example.employee.Female
    , myNumber = example.employee.MyNumber("123456789018")
    }

let hanakoCommon = example.employee.EmploymentCommon
    { identity = hanakoIdentity
    , personalName = example.employee.PersonalName
        { name = example.employee.PersonName("Sato Hanako"), kana = example.employee.KanaName("ｻﾄｳ ﾊﾅｺ") }
    , residence = example.employee.Residence
        { address = example.employee.Address
            { postalCode = example.employee.PostalCode("100-0001"), prefecture = PrefectureCode("13"), line = "Chiyoda 1-1" }
        }
    , terms = fullTimeTerms
    , remuneration = pay300k
    }

// The four employment types, one person each, with the sex, contract and schooling that differ between them.
let employedFullTime = Employed { ...hanakoCommon, hiredOn = Date("2020-04-01") }

let employedContract = Employed
    { ...hanakoCommon
    , identity = example.employee.PersonalIdentity { ...hanakoIdentity, sex = example.employee.Male }
    , terms = EmploymentTerms
        { ...fullTimeTerms
        , employmentType = ContractEmployee
        , contract = example.employee.TermUntil { endsOn = Date("2027-03-31") }
        , student = DaytimeStudent
        }
    , hiredOn = Date("2025-04-01")
    }

let employedPartTime = Employed { ...hanakoCommon, terms = shortTimeTerms, hiredOn = Date("2023-04-01") }

let employedExecutive = Employed
    { ...hanakoCommon
    , terms = EmploymentTerms { ...fullTimeTerms, employmentType = Executive }
    , hiredOn = Date("2015-04-01")
    }

example acquireCoverage
    | "an ordinary full-timer on 300,000 is in grade 22, which holds from the month of acquisition" :
        (Covered { route = RegularRoute, scope = HealthAndPension }, pay300k, Date("2026-04-01"))
        -> Insured { acquiredOn = Date("2026-04-01"), scope = HealthAndPension, route = RegularRoute, decision = GradeDecision { basis = OnAcquisition, standard = Yen(300000), health = HealthGrade(22), pension = PensionGrade(19), appliesFrom = ContributionMonth(Date("2026-04-01")) } }
    | "a short-time worker acquired in mid-month has the grade from that month's first day" :
        (Covered { route = ShortTimeRoute, scope = HealthAndPension }, pay110k, Date("2026-07-15"))
        -> Insured { acquiredOn = Date("2026-07-15"), scope = HealthAndPension, route = ShortTimeRoute, decision = GradeDecision { basis = OnAcquisition, standard = Yen(110000), health = HealthGrade(7), pension = PensionGrade(4), appliesFrom = ContributionMonth(Date("2026-07-01")) } }
    | "somebody between seventy and seventy-five is insured for health only" :
        (Covered { route = RegularRoute, scope = HealthOnly }, pay300k, Date("2026-10-01"))
        -> Insured { acquiredOn = Date("2026-10-01"), scope = HealthOnly, route = RegularRoute, decision = GradeDecision { basis = OnAcquisition, standard = Yen(300000), health = HealthGrade(22), pension = PensionGrade(19), appliesFrom = ContributionMonth(Date("2026-10-01")) } }
    | "a pay below the lowest bound is still grade 1, and pension grade 1 as well" :
        (Covered { route = RegularRoute, scope = HealthAndPension }, MonthlyRemuneration { ...pay300k, baseSalary = Yen(10000) }, Date("2026-04-01"))
        -> Insured { acquiredOn = Date("2026-04-01"), scope = HealthAndPension, route = RegularRoute, decision = GradeDecision { basis = OnAcquisition, standard = Yen(58000), health = HealthGrade(1), pension = PensionGrade(1), appliesFrom = ContributionMonth(Date("2026-04-01")) } }
    | "the highest grade is 50 for health and 32 for pension" :
        (Covered { route = RegularRoute, scope = HealthAndPension }, MonthlyRemuneration { ...pay300k, baseSalary = Yen(1360000) }, Date("2026-04-01"))
        -> Insured { acquiredOn = Date("2026-04-01"), scope = HealthAndPension, route = RegularRoute, decision = GradeDecision { basis = OnAcquisition, standard = Yen(1390000), health = HealthGrade(50), pension = PensionGrade(32), appliesFrom = ContributionMonth(Date("2026-04-01")) } }

example loseCoverage
    | "a grade decided on regular determination loses coverage the day after the separation" :
        (insuredFullTime, Date("2026-03-31"))
        -> CoverageLost { acquiredOn = Date("2020-04-01"), lostOn = Date("2026-04-01") }
    | "a grade decided on acquisition loses coverage the day after the separation" :
        (Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, basis = OnAcquisition } }, Date("2026-06-30"))
        -> CoverageLost { acquiredOn = Date("2020-04-01"), lostOn = Date("2026-07-01") }
    | "a grade decided on an occasional revision loses coverage the day after the separation" :
        (Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, basis = OccasionalRevision } }, Date("2026-12-31"))
        -> CoverageLost { acquiredOn = Date("2020-04-01"), lostOn = Date("2027-01-01") }
    | "a short-time worker loses coverage the day after the separation" :
        (Insured { ...insuredFullTime, route = ShortTimeRoute }, Date("2026-09-30"))
        -> CoverageLost { acquiredOn = Date("2020-04-01"), lostOn = Date("2026-10-01") }
    | "somebody insured for health only loses coverage the day after the separation" :
        (Insured { ...insuredFullTime, scope = HealthOnly }, Date("2026-05-31"))
        -> CoverageLost { acquiredOn = Date("2020-04-01"), lostOn = Date("2026-06-01") }
    | "separating on the day of acquisition is not before it, and coverage is lost the next day" :
        (insuredFullTime, Date("2020-04-01"))
        -> CoverageLost { acquiredOn = Date("2020-04-01"), lostOn = Date("2020-04-02") }
    | "a separation the day before the acquisition is reported rather than stored" :
        (insuredFullTime, Date("2020-03-31")) -> LossBeforeAcquisition
    | "a separation years before the acquisition is reported as well" :
        (insuredFullTime, Date("2010-01-01")) -> LossBeforeAcquisition
    | "the health grade at either end of the table does not change when coverage is lost" :
        (Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, standard = Yen(58000), health = HealthGrade(1), pension = PensionGrade(1) } }, Date("2026-08-31"))
        -> CoverageLost { acquiredOn = Date("2020-04-01"), lostOn = Date("2026-09-01") }
    | "nor does the highest grade" :
        (Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, standard = Yen(1390000), health = HealthGrade(50), pension = PensionGrade(32) } }, Date("2026-08-30"))
        -> CoverageLost { acquiredOn = Date("2020-04-01"), lostOn = Date("2026-08-31") }

example applyDecision
    | "a decision from the regular determination replaces the grade and keeps the rest of the record" :
        (insuredFullTime, currentGrade22)
        -> Insured { ...insuredFullTime, decision = currentGrade22 }
    | "an acquisition decision replaces it as well" :
        (insuredFullTime, GradeDecision { ...currentGrade22, basis = OnAcquisition })
        -> Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, basis = OnAcquisition } }
    | "and an occasional revision" :
        (insuredFullTime, GradeDecision { ...currentGrade22, basis = OccasionalRevision, standard = Yen(360000), health = HealthGrade(25), pension = PensionGrade(22) })
        -> Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, basis = OccasionalRevision, standard = Yen(360000), health = HealthGrade(25), pension = PensionGrade(22) } }
    | "the lowest grade replaces a higher one" :
        (insuredFullTime, GradeDecision { ...currentGrade22, standard = Yen(58000), health = HealthGrade(1), pension = PensionGrade(1) })
        -> Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, standard = Yen(58000), health = HealthGrade(1), pension = PensionGrade(1) } }
    | "the highest grade replaces a lower one" :
        (insuredFullTime, GradeDecision { ...currentGrade22, standard = Yen(1390000), health = HealthGrade(50), pension = PensionGrade(32) })
        -> Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, standard = Yen(1390000), health = HealthGrade(50), pension = PensionGrade(32) } }
    | "a short-time worker keeps the route when the grade changes" :
        (Insured { ...insuredFullTime, route = ShortTimeRoute }, currentGrade22)
        -> Insured { ...insuredShortTime, decision = currentGrade22 }
    | "somebody insured for health only keeps the scope when the grade changes" :
        (Insured { ...insuredFullTime, scope = HealthOnly }, currentGrade22)
        -> Insured { ...insuredHealthOnly, decision = currentGrade22 }
    | "a record whose own grade was decided on acquisition is replaced by a regular one" :
        (Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, basis = OnAcquisition } }, currentGrade22)
        -> Insured { ...insuredOnAcquisition, decision = currentGrade22 }
    | "and one decided by revision is replaced by a regular one" :
        (Insured { ...insuredFullTime, decision = GradeDecision { ...currentGrade22, basis = OccasionalRevision } }, currentGrade22)
        -> Insured { ...insuredRevised, decision = currentGrade22 }

example judgeLongTermCareCategory
    | "somebody of thirty-six is outside long-term care" :
        (Date("1990-04-01"), Date("2026-07-01")) -> OutsideLongTermCare
    | "somebody of fifty-one is insured" :
        (Date("1975-05-20"), Date("2026-07-01")) -> LongTermCareInsured
    | "born on 1 August 1986 he attains forty on 31 July 2026, the day before his birthday" :
        (Date("1986-08-01"), Date("2026-07-31")) -> LongTermCareInsured
    | "and one day earlier he has not" :
        (Date("1986-08-01"), Date("2026-07-30")) -> OutsideLongTermCare
    | "born on 1 August 1961 she attains sixty-five on 31 July 2026 and leaves" :
        (Date("1961-08-01"), Date("2026-07-31")) -> OutsideLongTermCare
    | "and one day earlier she is still insured" :
        (Date("1961-08-01"), Date("2026-07-30")) -> LongTermCareInsured

example judgePremiumExemption
    | "a full-timer at work owes the premium" :
        (employedFullTime) -> PremiumDue
    | "a contract employee at work owes it" :
        (employedContract) -> PremiumDue
    | "a part-timer at work owes it" :
        (employedPartTime) -> PremiumDue
    | "an executive at work owes it" :
        (employedExecutive) -> PremiumDue
    | "maternity leave exempts both halves" :
        (OnLeave { ...employedFullTime, leave = MaternityLeave, leaveFrom = Date("2026-01-01") }) -> PremiumExempt
    | "childcare leave exempts both halves" :
        (OnLeave { ...employedContract, leave = ChildcareLeave, leaveFrom = Date("2026-01-01") }) -> PremiumExempt
    | "sick leave exempts nothing" :
        (OnLeave { ...employedPartTime, leave = SickLeave, leaveFrom = Date("2026-01-01") }) -> PremiumDue
    | "caregiver leave exempts nothing" :
        (OnLeave { ...employedExecutive, leave = CaregiverLeave, leaveFrom = Date("2026-01-01") }) -> PremiumDue

example computePremium
    | "on 300,000 all three premiums are split evenly" :
        (Yen(300000), HealthAndPension, LongTermCareInsured, ratesTokyo)
        -> Premium { health = PremiumShare { employee = Yen(14865), employer = Yen(14865) }, longTermCare = PremiumShare { employee = Yen(2385), employer = Yen(2385) }, pension = PremiumShare { employee = Yen(27450), employer = Yen(27450) } }
    | "under forty there is no long-term care" :
        (Yen(300000), HealthAndPension, OutsideLongTermCare, ratesTokyo)
        -> Premium { health = PremiumShare { employee = Yen(14865), employer = Yen(14865) }, longTermCare = PremiumShare { employee = Yen(0), employer = Yen(0) }, pension = PremiumShare { employee = Yen(27450), employer = Yen(27450) } }
    | "over seventy there is no pension" :
        (Yen(300000), HealthOnly, LongTermCareInsured, ratesTokyo)
        -> Premium { health = PremiumShare { employee = Yen(14865), employer = Yen(14865) }, longTermCare = PremiumShare { employee = Yen(2385), employer = Yen(2385) }, pension = PremiumShare { employee = Yen(0), employer = Yen(0) } }
    | "health insurance alone" :
        (Yen(300000), HealthOnly, OutsideLongTermCare, ratesTokyo)
        -> Premium { health = PremiumShare { employee = Yen(14865), employer = Yen(14865) }, longTermCare = PremiumShare { employee = Yen(0), employer = Yen(0) }, pension = PremiumShare { employee = Yen(0), employer = Yen(0) } }
    | "a half of 10,901 yen is 5,450.5, which is dropped to 5,450 and the employer pays 5,451" :
        (Yen(110000), HealthAndPension, LongTermCareInsured, ratesTokyo)
        -> Premium { health = PremiumShare { employee = Yen(5450), employer = Yen(5451) }, longTermCare = PremiumShare { employee = Yen(874), employer = Yen(875) }, pension = PremiumShare { employee = Yen(10065), employer = Yen(10065) } }
    | "on 58,000 the lowest standard remuneration" :
        (Yen(58000), HealthAndPension, LongTermCareInsured, ratesTokyo)
        -> Premium { health = PremiumShare { employee = Yen(2874), employer = Yen(2873) }, longTermCare = PremiumShare { employee = Yen(461), employer = Yen(461) }, pension = PremiumShare { employee = Yen(5307), employer = Yen(5307) } }
    | "a rate of nothing is a premium of nothing, whatever the standard remuneration" :
        (Yen(300000), HealthAndPension, LongTermCareInsured, ContributionRates { health = ContributionRate(0.0m), longTermCare = ContributionRate(0.0m), pension = ContributionRate(0.0m) })
        -> Premium { health = PremiumShare { employee = Yen(0), employer = Yen(0) }
                   , longTermCare = PremiumShare { employee = Yen(0), employer = Yen(0) }
                   , pension = PremiumShare { employee = Yen(0), employer = Yen(0) }
                   }
    | "a rate of one is the whole standard remuneration, halved" :
        (Yen(58000), HealthAndPension, LongTermCareInsured, ContributionRates { health = ContributionRate(1.0m), longTermCare = ContributionRate(0.0m), pension = ContributionRate(0.0m) })
        -> Premium { health = PremiumShare { employee = Yen(29000), employer = Yen(29000) }
                   , longTermCare = PremiumShare { employee = Yen(0), employer = Yen(0) }
                   , pension = PremiumShare { employee = Yen(0), employer = Yen(0) }
                   }
